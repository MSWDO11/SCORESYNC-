{{> head }}
<style>
  body { background:#07090f; font-family:'Inter','Segoe UI',sans-serif; }
  .reg-glow { box-shadow: 0 0 80px rgba(99,102,241,0.12), 0 0 160px rgba(99,102,241,0.06); }
  .input-dark { background:rgba(15,17,30,0.8); border:1.5px solid rgba(99,102,241,0.2); color:#e0e7ff; border-radius:12px; width:100%; padding:11px 14px 11px 42px; font-size:0.875rem; outline:none; transition:border-color 0.2s, box-shadow 0.2s; }
  .input-dark::placeholder { color:#334155; }
  .input-dark:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,0.15); }
  .btn-register { background:linear-gradient(135deg,#6366f1,#8b5cf6); box-shadow:0 4px 24px rgba(99,102,241,0.45); border:none; color:#fff; font-weight:800; border-radius:12px; width:100%; padding:13px; font-size:0.875rem; cursor:pointer; transition:transform 0.15s,box-shadow 0.15s; display:flex; align-items:center; justify-content:center; gap:8px; }
  .btn-register:hover { transform:translateY(-2px); box-shadow:0 8px 32px rgba(99,102,241,0.6); }
  .role-card { border:1.5px solid rgba(99,102,241,0.15); border-radius:14px; padding:14px 10px; text-align:center; cursor:pointer; transition:border-color 0.2s, background 0.2s; background:rgba(15,17,30,0.6); }
  .role-card:hover { border-color:rgba(99,102,241,0.4); background:rgba(99,102,241,0.08); }
  input[type="radio"].sr-only:checked + .role-card { border-color:#6366f1; background:rgba(99,102,241,0.15); box-shadow:0 0 0 3px rgba(99,102,241,0.15); }
  .feature-pill { background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:14px 16px; display:flex; align-items:center; gap:12px; }
  @keyframes fadeup { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
  .fadeup { animation:fadeup 0.5s ease-out forwards; }
  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }
  .float { animation:float 3.5s ease-in-out infinite; }
</style>
<body class="min-h-screen flex">

  <!-- LEFT PANEL -->
  <div class="hidden lg:flex lg:w-[46%] flex-col justify-between p-12 relative overflow-hidden" style="background:linear-gradient(135deg,#0d0f1a 0%,#111827 60%,#0d0f1a 100%);border-right:1px solid rgba(99,102,241,0.15);">
    <!-- Rings -->
    <div class="absolute rounded-full pointer-events-none" style="width:500px;height:500px;top:50%;left:50%;transform:translate(-50%,-50%);border:1px solid rgba(99,102,241,0.08);"></div>
    <div class="absolute rounded-full pointer-events-none" style="width:750px;height:750px;top:50%;left:50%;transform:translate(-50%,-50%);border:1px solid rgba(99,102,241,0.05);"></div>
    <!-- Glows -->
    <div class="absolute pointer-events-none" style="width:300px;height:300px;top:10%;left:10%;background:rgba(99,102,241,0.1);border-radius:50%;filter:blur(80px);"></div>
    <div class="absolute pointer-events-none" style="width:200px;height:200px;bottom:10%;right:5%;background:rgba(139,92,246,0.08);border-radius:50%;filter:blur(60px);"></div>

    <!-- Logo -->
    <div class="relative z-10 flex items-center gap-3">
      <div class="w-11 h-11 rounded-2xl flex items-center justify-center shadow-lg" style="background:linear-gradient(135deg,#f59e0b,#fbbf24);box-shadow:0 0 20px rgba(251,191,36,0.35);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
      </div>
      <span class="font-black text-2xl tracking-tight" style="color:#e0e7ff;">Score<span style="color:#a5b4fc;">Sync</span></span>
    </div>

    <!-- Center -->
    <div class="relative z-10 my-auto">
      <div class="float inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold mb-8" style="background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.3);color:#a5b4fc;">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse inline-block"></span>
        Mansalay, Oriental Mindoro
      </div>
      <h2 class="font-black text-4xl leading-tight tracking-tight mb-4" style="color:#e0e7ff;">Request a<br/><span style="background:linear-gradient(135deg,#a5b4fc,#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">ScoreSync Account.</span></h2>
      <p class="text-sm leading-relaxed max-w-xs" style="color:#475569;">Submit an account request to the Administrator for approval and get notified directly on your Gmail once confirmed.</p>

      <div class="mt-10 space-y-3">
        <div class="feature-pill">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);box-shadow:0 0 12px rgba(59,130,246,0.3);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div><div class="text-sm font-bold" style="color:#e0e7ff;">Admin Approval</div><div class="text-xs mt-0.5" style="color:#475569;">Request reviewed by Administrator</div></div>
        </div>
        <div class="feature-pill">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#064e3b,#10b981);box-shadow:0 0 12px rgba(16,185,129,0.3);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div><div class="text-sm font-bold" style="color:#e0e7ff;">Gmail Notification</div><div class="text-xs mt-0.5" style="color:#475569;">Get notified once approved</div></div>
        </div>
        <div class="feature-pill">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#4c1d95,#7c3aed);box-shadow:0 0 12px rgba(124,58,237,0.3);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div><div class="text-sm font-bold" style="color:#e0e7ff;">Role-Based Access</div><div class="text-xs mt-0.5" style="color:#475569;">Judge or Encoder portal</div></div>
        </div>
      </div>
    </div>

    <p class="relative z-10 text-xs" style="color:#475569;">&copy; 2026 ScoreSync &mdash; Mansalay, Oriental Mindoro</p>
  </div>

  <!-- RIGHT PANEL -->
  <div class="flex-1 flex items-center justify-center px-6 py-12" style="background:#07090f;">
    <div class="w-full max-w-[420px] fadeup">

      <!-- Mobile logo -->
      <div class="flex items-center gap-2.5 justify-center mb-8 lg:hidden">
        <div class="w-10 h-10 rounded-2xl flex items-center justify-center" style="background:linear-gradient(135deg,#f59e0b,#fbbf24);box-shadow:0 0 16px rgba(251,191,36,0.35);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        </div>
        <span class="font-black text-xl tracking-tight" style="color:#e0e7ff;">Score<span style="color:#a5b4fc;">Sync</span></span>
      </div>

      <!-- Card -->
      <div class="rounded-2xl p-8 reg-glow" style="background:rgba(13,15,26,0.95);border:1px solid rgba(99,102,241,0.2);">

        <!-- Back to Home -->
        <div class="mb-5">
          <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold transition" style="color:#475569;"
            onmouseover="this.style.color='#a5b4fc'" onmouseout="this.style.color='#475569'">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Home
          </a>
        </div>

        <div class="mb-7">
          <h1 class="text-2xl font-black tracking-tight" style="color:#e0e7ff;">Create Account</h1>
          <p class="text-sm mt-1" style="color:#475569;">Submit your request to the Administrator for approval.</p>
        </div>

        {{#if error_msg}}
        <div class="flex items-center gap-2.5 p-3.5 rounded-xl mb-5 text-sm font-semibold" style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>{{error_msg}}</span>
        </div>
        {{/if}}
        {{#if success_msg}}
        <div class="flex items-center gap-2.5 p-3.5 rounded-xl mb-5 text-sm font-semibold" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
          <span>{{success_msg}}</span>
        </div>
        {{/if}}

        <form method="POST" action="/register" class="space-y-5">

          <!-- Full Name -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-widest mb-2" style="color:#475569;">Full Name</label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#334155;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </span>
              <input type="text" name="name" placeholder="Juan dela Cruz" required class="input-dark"/>
            </div>
          </div>

          <!-- Email -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-widest mb-2" style="color:#475569;">Email Address</label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#334155;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="input-dark"/>
            </div>
          </div>

          <!-- Password -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-widest mb-2" style="color:#475569;">Password</label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#334155;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" name="password" id="passwordInput" placeholder="Min. 6 characters" required minlength="6" autocomplete="new-password" class="input-dark" style="padding-right:42px;"/>
              <button type="button" id="eyeBtn" onclick="togglePwd()" class="absolute right-3.5 top-1/2 -translate-y-1/2 transition" style="color:#334155;" onmouseover="this.style.color='#a5b4fc'" onmouseout="this.style.color='#334155'">
                <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <!-- Role -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-widest mb-3" style="color:#475569;">Select Role</label>
            <div class="grid grid-cols-2 gap-3">
              <label class="cursor-pointer">
                <input type="radio" name="role" value="judge" class="sr-only" required id="roleJudge" onchange="styleRoles()"/>
                <div id="cardJudge" class="role-card">
                  <div class="w-9 h-9 rounded-xl flex items-center justify-center mx-auto mb-2.5" style="background:linear-gradient(135deg,#4c1d95,#7c3aed);box-shadow:0 0 12px rgba(124,58,237,0.3);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  </div>
                  <div class="font-bold text-sm" style="color:#e0e7ff;">Judge</div>
                  <div class="text-xs mt-0.5" style="color:#475569;">Score contestants</div>
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="role" value="encoder" class="sr-only" id="roleEncoder" onchange="styleRoles()"/>
                <div id="cardEncoder" class="role-card">
                  <div class="w-9 h-9 rounded-xl flex items-center justify-center mx-auto mb-2.5" style="background:linear-gradient(135deg,#064e3b,#10b981);box-shadow:0 0 12px rgba(16,185,129,0.3);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  </div>
                  <div class="font-bold text-sm" style="color:#e0e7ff;">Encoder</div>
                  <div class="text-xs mt-0.5" style="color:#475569;">Manage contestants</div>
                </div>
              </label>
            </div>
          </div>

          <button type="submit" class="btn-register">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            Request Account
          </button>
        </form>
      </div>

      <p class="text-center text-sm mt-5" style="color:#334155;">Already have an account? <a href="/login" class="font-bold transition" style="color:#6366f1;" onmouseover="this.style.color='#a5b4fc'" onmouseout="this.style.color='#6366f1'">Sign in</a></p>
    </div>
  </div>

<script>
const eyeOpen='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePwd(){const i=document.getElementById('passwordInput'),b=document.getElementById('eyeIcon');if(i.type==='password'){i.type='text';b.outerHTML=eyeClose;}else{i.type='password';b.outerHTML=eyeOpen;}}
function styleRoles(){
  const j=document.getElementById('roleJudge').checked;
  const e=document.getElementById('roleEncoder').checked;
  document.getElementById('cardJudge').style.borderColor = j ? '#6366f1' : 'rgba(99,102,241,0.15)';
  document.getElementById('cardJudge').style.background  = j ? 'rgba(99,102,241,0.15)' : 'rgba(15,17,30,0.6)';
  document.getElementById('cardEncoder').style.borderColor = e ? '#10b981' : 'rgba(99,102,241,0.15)';
  document.getElementById('cardEncoder').style.background  = e ? 'rgba(16,185,129,0.12)' : 'rgba(15,17,30,0.6)';
}
</script>
</body>
</html>
