{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0b0f1e;color:#e2e8f0;">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="flex items-center gap-3 p-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 text-sm font-semibold"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="flex items-center gap-3 p-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 text-sm font-semibold"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg>{{error_msg}}</div>{{/if}}

  <!-- Header -->
  <div class="rounded-2xl p-6 sm:p-8 relative overflow-hidden" style="background:linear-gradient(135deg,#0f172a 0%,#064e3b 60%,#065f46 100%);">
    <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at 80% 50%,rgba(16,185,129,0.12) 0%,transparent 60%);"></div>
    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider" style="background:rgba(16,185,129,0.25);border:1px solid rgba(16,185,129,0.4);color:#6ee7b7;">Organizer</span>
          <span class="flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold" style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.25);color:#6ee7b7;">
            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-ping inline-block"></span> Active
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight" style="color:#e0e7ff;">Welcome, <span style="color:#6ee7b7;">{{userName}}</span></h1>
        <p class="text-sm mt-1" style="color:#475569;">Showing upcoming and ongoing events only.</p>
      </div>
      <a href="/events" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm text-white transition self-start" style="background:linear-gradient(135deg,#059669,#10b981);box-shadow:0 4px 16px rgba(16,185,129,0.35);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        All Events
      </a>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 gap-4">
    <div class="rounded-2xl p-5 text-white" style="background:linear-gradient(135deg,#064e3b,#059669);box-shadow:0 4px 20px rgba(5,150,105,0.25);">
      <div class="text-[10px] font-black uppercase tracking-widest mb-2" style="color:rgba(255,255,255,0.6);">Active Events</div>
      <div class="text-3xl font-black">{{totalActive}}</div>
      <div class="text-xs mt-1" style="color:rgba(255,255,255,0.5);">Upcoming + Ongoing</div>
    </div>
    <div class="rounded-2xl p-5 text-white" style="background:linear-gradient(135deg,#1e3a8a,#2563eb);box-shadow:0 4px 20px rgba(37,99,235,0.25);">
      <div class="text-[10px] font-black uppercase tracking-widest mb-2" style="color:rgba(255,255,255,0.6);">Ongoing Now</div>
      <div class="text-3xl font-black">{{ongoingCount}}</div>
      <div class="text-xs mt-1" style="color:rgba(255,255,255,0.5);">In progress</div>
    </div>
  </div>

  <!-- Events List -->
  <div class="rounded-2xl overflow-hidden" style="background:rgba(12,15,30,0.95);border:1px solid rgba(16,185,129,0.18);">
    <div class="px-6 py-4 flex items-center justify-between" style="border-bottom:1px solid rgba(16,185,129,0.12);">
      <h2 class="text-sm font-extrabold" style="color:#e0e7ff;">Events — Upcoming &amp; Ongoing</h2>
      <span class="px-2.5 py-1 rounded-full text-[11px] font-bold" style="background:rgba(16,185,129,0.15);color:#34d399;border:1px solid rgba(16,185,129,0.25);">{{totalActive}} events</span>
    </div>
    {{#if activeEvents.length}}
    <div>
      {{#each activeEvents}}
      <div class="flex items-center justify-between px-6 py-4 transition group" style="border-bottom:1px solid rgba(255,255,255,0.04);" onmouseover="this.style.background='rgba(16,185,129,0.05)'" onmouseout="this.style.background='transparent'">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:{{#if (eq status 'ongoing')}}rgba(5,150,105,0.2){{else}}rgba(37,99,235,0.15){{/if}};">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{{#if (eq status 'ongoing')}}#34d399{{else}}#93c5fd{{/if}}" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <a href="/events/{{id}}" class="font-bold text-sm transition" style="color:#e0e7ff;" onmouseover="this.style.color='#6ee7b7'" onmouseout="this.style.color='#e0e7ff'">{{name}}</a>
            <div class="text-xs mt-0.5 capitalize" style="color:#334155;">{{type}} &bull; {{#if date}}{{date}}{{else}}Date TBD{{/if}}</div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-full text-[11px] font-black capitalize" style="{{#if (eq status 'ongoing')}}background:rgba(16,185,129,0.15);color:#34d399;border:1px solid rgba(16,185,129,0.3);{{else}}background:rgba(59,130,246,0.15);color:#93c5fd;border:1px solid rgba(59,130,246,0.3);{{/if}}">{{status}}</span>
          <a href="/events/{{id}}" class="px-3 py-1.5 rounded-xl text-xs font-bold transition" style="background:rgba(255,255,255,0.06);color:#94a3b8;" onmouseover="this.style.background='rgba(16,185,129,0.12)';this.style.color='#34d399'" onmouseout="this.style.background='rgba(255,255,255,0.06)';this.style.color='#94a3b8'">Manage</a>
          <a href="/events/{{id}}/contestants/add" class="px-3 py-1.5 rounded-xl text-xs font-bold transition" style="background:rgba(16,185,129,0.12);color:#34d399;" onmouseover="this.style.background='rgba(16,185,129,0.22)'" onmouseout="this.style.background='rgba(16,185,129,0.12)'">&plus; Contestant</a>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="py-16 flex flex-col items-center justify-center text-center">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4" style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <p class="font-bold" style="color:#475569;">No active events right now.</p>
      <p class="text-sm mt-1" style="color:#334155;">Check back when events are scheduled.</p>
    </div>
    {{/if}}
  </div>

  <!-- Stage Timer -->
  {{> countdown_timer }}

</main>
</div>
{{> footer }}
</body>
</html>
