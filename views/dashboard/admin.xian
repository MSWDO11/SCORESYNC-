{{> head }}
<style>
  body { background:#070b14; color:#e2e8f0; }
  /* Bento grid cards */
  .bento { background:rgba(12,15,30,0.9); border:1px solid rgba(255,255,255,0.06); border-radius:24px; transition:border-color 0.2s; }
  .bento:hover { border-color:rgba(99,102,241,0.25); }
  .bento-accent { background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(139,92,246,0.06)); border:1px solid rgba(99,102,241,0.2); border-radius:24px; }
  /* KPI */
  .stat-card { border-radius:20px; overflow:hidden; position:relative; }
  /* Shortcuts */
  .cmd-btn { display:flex; align-items:center; gap:12px; padding:12px 14px; border-radius:14px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.05); transition:all 0.18s; text-decoration:none; }
  .cmd-btn:hover { background:rgba(99,102,241,0.1); border-color:rgba(99,102,241,0.3); transform:translateX(3px); }
  /* Table */
  .ev-row { border-bottom:1px solid rgba(255,255,255,0.04); transition:background 0.15s; }
  .ev-row:hover { background:rgba(99,102,241,0.05); }
  /* Badges */
  .b-ongoing   { background:rgba(16,185,129,0.15); color:#34d399; border:1px solid rgba(16,185,129,0.25); border-radius:999px; padding:2px 10px; font-size:11px; font-weight:800; }
  .b-upcoming  { background:rgba(59,130,246,0.15); color:#93c5fd; border:1px solid rgba(59,130,246,0.25); border-radius:999px; padding:2px 10px; font-size:11px; font-weight:800; }
  .b-completed { background:rgba(99,102,241,0.15); color:#a5b4fc; border:1px solid rgba(99,102,241,0.25); border-radius:999px; padding:2px 10px; font-size:11px; font-weight:800; }
  .b-cancelled { background:rgba(239,68,68,0.15); color:#fca5a5; border:1px solid rgba(239,68,68,0.25); border-radius:999px; padding:2px 10px; font-size:11px; font-weight:800; }
  /* Animations */
  @keyframes up { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
  .u0{animation:up 0.35s ease both}
  .u1{animation:up 0.35s 0.08s ease both}
  .u2{animation:up 0.35s 0.16s ease both}
  .u3{animation:up 0.35s 0.24s ease both}
  /* Sparkline bars */
  .spark { display:flex; align-items:flex-end; gap:3px; height:28px; }
  .spark-bar { width:5px; border-radius:3px; background:rgba(255,255,255,0.25); flex-shrink:0; }
  /* Mesh background blob */
  .mesh-blob { position:absolute; border-radius:50%; filter:blur(80px); pointer-events:none; }
</style>

<body style="background:#070b14;" class="min-h-screen flex flex-col">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}

<main class="flex-1 overflow-y-auto px-4 py-5 sm:px-6 sm:py-6 lg:px-8 lg:py-8" style="background:radial-gradient(ellipse at 20% 0%,rgba(99,102,241,0.07) 0%,transparent 50%),radial-gradient(ellipse at 80% 80%,rgba(139,92,246,0.05) 0%,transparent 50%),#070b14;">

  {{#if success_msg}}<div class="flex items-center gap-3 p-4 rounded-2xl text-sm font-semibold mb-5 u0" style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.25);color:#6ee7b7;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="flex items-center gap-3 p-4 rounded-2xl text-sm font-semibold mb-5 u0" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.25);color:#fca5a5;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg>{{error_msg}}</div>{{/if}}

  <!-- ── HEADER ── -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-7 u0">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="text-[11px] font-black uppercase tracking-widest" style="color:#4f46e5;" id="today-date">Today</span>
        <span class="w-1 h-1 rounded-full" style="background:#334155;"></span>
        <span class="flex items-center gap-1 text-[11px] font-bold" style="color:#34d399;">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping inline-block"></span>
          Live
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight" style="color:#f1f5f9;">
        Hello, <span style="background:linear-gradient(90deg,#818cf8,#c084fc,#fb923c);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">{{userName}}</span> 👋
      </h1>
      <p class="text-sm mt-1" style="color:#334155;">ScoreSync Admin Control Center</p>
    </div>
    <a href="/events/create"
      class="inline-flex items-center gap-2.5 px-6 py-3 rounded-2xl font-black text-sm text-white flex-shrink-0"
      style="background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 0 0 1px rgba(99,102,241,0.3),0 8px 32px rgba(99,102,241,0.35);">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Event
    </a>
  </div>

  {{#if pendingCount}}
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-2xl mb-6 u1" style="background:linear-gradient(90deg,rgba(245,158,11,0.1),rgba(245,158,11,0.05));border:1px solid rgba(245,158,11,0.25);">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(245,158,11,0.15);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <span class="font-extrabold text-sm" style="color:#fcd34d;">{{pendingCount}} account request(s) pending</span>
        <p class="text-xs" style="color:#78350f;">Awaiting your approval</p>
      </div>
    </div>
    <a href="/users" class="text-xs font-black px-4 py-2 rounded-xl flex-shrink-0" style="background:#f59e0b;color:#000;">Review →</a>
  </div>
  {{/if}}

  <!-- ── BENTO KPI GRID ── -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6 u1">

    <div class="stat-card p-5" style="background:linear-gradient(135deg,#0f1f6e,#1d4ed8);box-shadow:0 0 0 1px rgba(59,130,246,0.2),0 8px 32px rgba(29,78,216,0.25);">
      <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(circle at 85% 15%,rgba(255,255,255,0.1),transparent 55%);"></div>
      <div class="relative z-10 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-black uppercase tracking-widest text-blue-300">Total Events</span>
          <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.12);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
        </div>
        <p class="text-5xl font-black leading-none text-white">{{totalEvents}}</p>
        <div class="spark">
          <div class="spark-bar" style="height:40%;"></div><div class="spark-bar" style="height:60%;"></div><div class="spark-bar" style="height:45%;"></div><div class="spark-bar" style="height:75%;"></div><div class="spark-bar" style="height:55%;"></div><div class="spark-bar" style="height:90%;background:rgba(255,255,255,0.7);"></div>
        </div>
        <a href="/events" class="text-blue-200 text-xs font-bold flex items-center gap-1">All events <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></a>
      </div>
    </div>

    <div class="stat-card p-5" style="background:linear-gradient(135deg,#052e1f,#047857);box-shadow:0 0 0 1px rgba(16,185,129,0.2),0 8px 32px rgba(4,120,87,0.25);">
      <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(circle at 85% 15%,rgba(255,255,255,0.1),transparent 55%);"></div>
      <div class="relative z-10 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-black uppercase tracking-widest text-emerald-300">Active Users</span>
          <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.12);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          </div>
        </div>
        <p class="text-5xl font-black leading-none text-white">{{totalUsers}}</p>
        <div class="spark">
          <div class="spark-bar" style="height:50%;"></div><div class="spark-bar" style="height:65%;"></div><div class="spark-bar" style="height:80%;"></div><div class="spark-bar" style="height:70%;"></div><div class="spark-bar" style="height:85%;"></div><div class="spark-bar" style="height:95%;background:rgba(255,255,255,0.7);"></div>
        </div>
        <a href="/users" class="text-emerald-200 text-xs font-bold flex items-center gap-1">Manage <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></a>
      </div>
    </div>

    <div class="stat-card p-5" style="background:linear-gradient(135deg,#3b0764,#7c3aed);box-shadow:0 0 0 1px rgba(124,58,237,0.2),0 8px 32px rgba(124,58,237,0.25);">
      <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(circle at 85% 15%,rgba(255,255,255,0.1),transparent 55%);"></div>
      <div class="relative z-10 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-black uppercase tracking-widest text-purple-300">Pending</span>
          <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.12);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
        </div>
        <p class="text-5xl font-black leading-none text-white">{{pendingCount}}</p>
        <div class="spark">
          <div class="spark-bar" style="height:30%;"></div><div class="spark-bar" style="height:50%;"></div><div class="spark-bar" style="height:40%;"></div><div class="spark-bar" style="height:60%;"></div><div class="spark-bar" style="height:35%;"></div><div class="spark-bar" style="height:{{#if pendingCount}}70{{else}}10{{/if}}%;background:rgba(255,255,255,0.7);"></div>
        </div>
        <a href="/users" class="text-purple-200 text-xs font-bold flex items-center gap-1">Review <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></a>
      </div>
    </div>

    <div class="stat-card p-5" style="background:linear-gradient(135deg,#052e16,#15803d);box-shadow:0 0 0 1px rgba(22,163,74,0.2),0 8px 32px rgba(22,163,74,0.25);">
      <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(circle at 85% 15%,rgba(255,255,255,0.1),transparent 55%);"></div>
      <div class="relative z-10 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-black uppercase tracking-widest text-green-300">Revenue</span>
          <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.12);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
        </div>
        <p class="text-3xl font-black leading-none text-white">₱{{totalIncome}}</p>
        <div class="spark">
          <div class="spark-bar" style="height:20%;"></div><div class="spark-bar" style="height:45%;"></div><div class="spark-bar" style="height:35%;"></div><div class="spark-bar" style="height:55%;"></div><div class="spark-bar" style="height:65%;"></div><div class="spark-bar" style="height:{{#if paidEventsCount}}80{{else}}10{{/if}}%;background:rgba(255,255,255,0.7);"></div>
        </div>
        <a href="/inventory" class="text-green-200 text-xs font-bold flex items-center gap-1">Inventory <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></a>
      </div>
    </div>

  </div>

  <!-- ── BENTO MAIN GRID ── -->
  <div class="grid lg:grid-cols-7 gap-4 u2">

    <!-- Events table — 4 cols -->
    <div class="lg:col-span-4 bento overflow-hidden flex flex-col" style="min-height:380px;">
      <div class="px-6 py-4 flex items-center justify-between flex-shrink-0" style="border-bottom:1px solid rgba(255,255,255,0.05);">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 rounded-full" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 0 8px rgba(99,102,241,0.6);"></div>
          <span class="text-sm font-extrabold" style="color:#e0e7ff;">Recent Competitions</span>
        </div>
        <a href="/events" class="text-[11px] font-black uppercase tracking-wider transition" style="color:#4f46e5;" onmouseover="this.style.color='#a5b4fc'" onmouseout="this.style.color='#4f46e5'">View all →</a>
      </div>

      {{#if recentEvents.length}}
      <div class="overflow-x-auto flex-1">
        <table class="w-full text-left" style="min-width:520px;">
          <thead>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
              <th class="py-3 px-6 text-[10px] font-black uppercase tracking-widest" style="color:#1e293b;">Event</th>
              <th class="py-3 px-3 text-[10px] font-black uppercase tracking-widest" style="color:#1e293b;">Type</th>
              <th class="py-3 px-3 text-[10px] font-black uppercase tracking-widest" style="color:#1e293b;">Status</th>
              <th class="py-3 px-6 text-[10px] font-black uppercase tracking-widest text-right" style="color:#1e293b;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentEvents}}
            <tr class="ev-row">
              <td class="py-3 px-6">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#1e1b4b,#4338ca);">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
                  </div>
                  <div>
                    <a href="/events/{{id}}" class="text-sm font-bold block" style="color:#e0e7ff;" onmouseover="this.style.color='#a5b4fc'" onmouseout="this.style.color='#e0e7ff'">{{name}}</a>
                    {{#if date}}<span class="text-[11px]" style="color:#1e293b;">{{date}}</span>{{/if}}
                  </div>
                </div>
              </td>
              <td class="py-3 px-3">
                <span class="text-[11px] font-bold capitalize px-2.5 py-1 rounded-lg" style="background:rgba(99,102,241,0.12);color:#818cf8;border:1px solid rgba(99,102,241,0.2);">{{type}}</span>
              </td>
              <td class="py-3 px-3">
                <span class="{{#if (eq status 'ongoing')}}b-ongoing{{else}}{{#if (eq status 'completed')}}b-completed{{else}}{{#if (eq status 'cancelled')}}b-cancelled{{else}}b-upcoming{{/if}}{{/if}}{{/if}}">{{status}}</span>
              </td>
              <td class="py-3 px-6">
                <div class="flex items-center justify-end gap-1.5">
                  <a href="/events/{{id}}" class="p-1.5 rounded-lg" style="color:#6366f1;" title="View" onmouseover="this.style.background='rgba(99,102,241,0.15)'" onmouseout="this.style.background='transparent'"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
                  <a href="/events/{{id}}/edit" class="p-1.5 rounded-lg" style="color:#475569;" title="Edit" onmouseover="this.style.background='rgba(255,255,255,0.06)';this.style.color='#e0e7ff'" onmouseout="this.style.background='transparent';this.style.color='#475569'"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></a>
                  <a href="/events/{{id}}/results" class="p-1.5 rounded-lg" style="color:#34d399;" title="Results" onmouseover="this.style.background='rgba(16,185,129,0.12)'" onmouseout="this.style.background='transparent'"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></a>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="flex-1 flex flex-col items-center justify-center py-12 text-center">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4" style="background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.15);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <p class="font-bold text-sm" style="color:#334155;">No events yet</p>
        <a href="/events/create" class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm text-white" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);">+ Create First Event</a>
      </div>
      {{/if}}
    </div>

    <!-- Right 3 cols: shortcuts + revenue mini -->
    <div class="lg:col-span-3 flex flex-col gap-4">

      <!-- Quick Launch -->
      <div class="bento-accent p-5 flex-shrink-0">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-2 h-2 rounded-full" style="background:#fbbf24;box-shadow:0 0 8px rgba(251,191,36,0.5);"></div>
          <span class="text-sm font-extrabold" style="color:#e0e7ff;">Quick Actions</span>
        </div>
        <div class="space-y-2">
          <a href="/events/create" class="cmd-btn">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#1e1b4b,#4338ca);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold" style="color:#e0e7ff;">New Competition</div>
              <div class="text-[11px]" style="color:#334155;">Event + venue + criteria</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="2.5" class="ml-auto"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/users" class="cmd-btn">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#4c1d95,#7c3aed);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold" style="color:#e0e7ff;">User Management</div>
              <div class="text-[11px]" style="color:#334155;">Judges &amp; organizers</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="2.5" class="ml-auto"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/analytics" class="cmd-btn">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#1e1b4b,#6366f1);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold" style="color:#e0e7ff;">AI Score Audit</div>
              <div class="text-[11px]" style="color:#334155;">Detect anomalies</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="2.5" class="ml-auto"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/inventory" class="cmd-btn">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#064e3b,#16a34a);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold" style="color:#e0e7ff;">Payment Inventory</div>
              <div class="text-[11px]" style="color:#334155;">Ticket revenue</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="2.5" class="ml-auto"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

      <!-- Revenue mini card -->
      {{#if paidEventsCount}}
      <div class="bento p-5 flex-1" style="background:linear-gradient(135deg,rgba(6,78,59,0.6),rgba(22,163,74,0.2));border-color:rgba(22,163,74,0.2);">
        <div class="flex items-center justify-between mb-3">
          <span class="text-[10px] font-black uppercase tracking-widest" style="color:#34d399;">Revenue Summary</span>
          <a href="/inventory" class="text-[11px] font-black" style="color:#34d399;">Details →</a>
        </div>
        <p class="text-3xl font-black mb-1" style="color:#f0fdf4;">₱{{totalIncome}}</p>
        <p class="text-xs mb-4" style="color:#166534;">{{paidEventsCount}} ticketed event(s) &bull; {{totalTicketsSold}} tickets sold</p>
        <div class="grid grid-cols-2 gap-2">
          {{#each incomeByEvent}}
          {{#if @first}}
          <div class="col-span-2 flex items-center justify-between p-2.5 rounded-xl" style="background:rgba(22,163,74,0.1);border:1px solid rgba(22,163,74,0.15);">
            <span class="text-xs font-bold truncate max-w-[120px]" style="color:#bbf7d0;">{{name}}</span>
            <span class="text-xs font-black" style="color:#34d399;">₱<span data-fmt-income="{{income}}">{{income}}</span></span>
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>
      {{else}}
      <div class="bento p-5 flex-1 flex flex-col items-center justify-center text-center">
        <div class="w-10 h-10 rounded-2xl flex items-center justify-center mb-3" style="background:rgba(22,163,74,0.08);border:1px solid rgba(22,163,74,0.15);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <p class="text-xs font-bold" style="color:#334155;">No ticketed events yet</p>
        <p class="text-[11px] mt-1" style="color:#1e293b;">Create a concert or festival to track revenue</p>
      </div>
      {{/if}}

    </div>
  </div>

  <!-- ── INCOME BREAKDOWN (full width, only if data exists) ── -->
  {{#if paidEventsCount}}
  <div class="bento overflow-hidden mt-4 u3">
    <div class="px-6 py-4 flex items-center gap-3" style="border-bottom:1px solid rgba(255,255,255,0.05);">
      <div class="w-2 h-2 rounded-full" style="background:#34d399;box-shadow:0 0 8px rgba(52,211,153,0.5);"></div>
      <span class="text-sm font-extrabold" style="color:#e0e7ff;">Revenue Breakdown</span>
      <span class="ml-auto text-[11px] font-black px-2.5 py-1 rounded-full" style="background:rgba(22,163,74,0.15);color:#34d399;border:1px solid rgba(22,163,74,0.25);">{{paidEventsCount}} event(s)</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left" style="min-width:500px;">
        <thead>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <th class="py-3 px-6 text-[10px] font-black uppercase tracking-widest" style="color:#1e293b;">Event</th>
            <th class="py-3 px-4 text-[10px] font-black uppercase tracking-widest" style="color:#1e293b;">Type</th>
            <th class="py-3 px-4 text-[10px] font-black uppercase tracking-widest text-right" style="color:#1e293b;">Ticket Price</th>
            <th class="py-3 px-4 text-[10px] font-black uppercase tracking-widest text-right" style="color:#1e293b;">Sold</th>
            <th class="py-3 px-6 text-[10px] font-black uppercase tracking-widest text-right" style="color:#1e293b;">Revenue</th>
          </tr>
        </thead>
        <tbody>
          {{#each incomeByEvent}}
          <tr class="ev-row">
            <td class="py-3.5 px-6 font-bold text-sm" style="color:#e0e7ff;">{{name}}</td>
            <td class="py-3.5 px-4"><span class="text-[11px] font-bold capitalize px-2.5 py-1 rounded-lg" style="background:rgba(99,102,241,0.12);color:#818cf8;">{{type}}</span></td>
            <td class="py-3.5 px-4 text-right text-xs font-semibold" style="color:#475569;">₱{{ticketPrice}}</td>
            <td class="py-3.5 px-4 text-right text-xs font-semibold" style="color:#475569;">{{ticketsSold}}</td>
            <td class="py-3.5 px-6 text-right font-black" style="color:#34d399;">₱<span data-fmt-income="{{income}}">{{income}}</span></td>
          </tr>
          {{/each}}
        </tbody>
        <tfoot style="border-top:1px solid rgba(22,163,74,0.2);">
          <tr>
            <td colspan="4" class="py-3 px-6 text-[11px] font-black uppercase tracking-wider text-right" style="color:#334155;">Total</td>
            <td class="py-3 px-6 text-right font-black" style="color:#34d399;">₱{{totalIncome}}</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  {{/if}}

</main>
</div>
{{> footer }}
</body>
<script>
  const d=new Date(),days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],months=['January','February','March','April','May','June','July','August','September','October','November','December'];
  const el=document.getElementById('today-date');
  if(el) el.textContent=days[d.getDay()]+', '+months[d.getMonth()]+' '+d.getDate();
  document.querySelectorAll('[data-fmt-income]').forEach(function(span){
    const v=parseFloat(span.getAttribute('data-fmt-income'))||0;
    span.textContent=v.toLocaleString('en-PH',{minimumFractionDigits:2,maximumFractionDigits:2});
  });
</script>
</html>
