<!-- ScoreSync Event Stage & Round Countdown Timer — Premium Digital Edition -->
<style>
  .st-root { font-family: 'Inter', 'Segoe UI', sans-serif; }
  .st-glow-ring { filter: drop-shadow(0 0 8px rgba(99,102,241,0.7)); }
  .st-glow-ring-warn { filter: drop-shadow(0 0 10px rgba(251,146,60,0.8)); }
  .st-glow-ring-crit { filter: drop-shadow(0 0 12px rgba(239,68,68,0.9)); }
  .st-digits-glow { text-shadow: 0 0 30px rgba(99,102,241,0.5), 0 0 60px rgba(99,102,241,0.2); }
  .st-digits-glow-warn { text-shadow: 0 0 30px rgba(251,146,60,0.6), 0 0 60px rgba(251,146,60,0.2); }
  .st-digits-glow-crit { text-shadow: 0 0 30px rgba(239,68,68,0.7), 0 0 60px rgba(239,68,68,0.3); animation: st-pulse-crit 0.6s ease-in-out infinite alternate; }
  @keyframes st-pulse-crit { from { opacity:1; } to { opacity:0.7; } }
  .st-glass { background: rgba(255,255,255,0.04); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); }
  .st-btn-primary { background: linear-gradient(135deg,#6366f1,#8b5cf6); box-shadow: 0 4px 20px rgba(99,102,241,0.4); }
  .st-btn-primary:hover { background: linear-gradient(135deg,#818cf8,#a78bfa); box-shadow: 0 6px 28px rgba(99,102,241,0.6); }
  .st-progress-shimmer { background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent); background-size: 200% 100%; animation: st-shimmer 2s infinite; }
  @keyframes st-shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
  .st-scan-line { background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.015) 2px, rgba(255,255,255,0.015) 4px); pointer-events:none; }
</style>

<div id="scoresync-timer-component" class="st-root overflow-hidden rounded-2xl" style="background:linear-gradient(135deg,#0d0f1a 0%,#111827 50%,#0d0f1a 100%); border:1px solid rgba(99,102,241,0.25); box-shadow:0 0 0 1px rgba(99,102,241,0.1), 0 20px 60px rgba(0,0,0,0.5);">

  <!-- Scan line overlay for CRT effect -->
  <div class="st-scan-line absolute inset-0 z-0 pointer-events-none rounded-2xl"></div>

  <!-- ── HEADER BAR ── -->
  <div class="relative z-10 px-5 py-4 flex flex-wrap items-center justify-between gap-3" style="background:linear-gradient(90deg,rgba(99,102,241,0.15),rgba(139,92,246,0.1),rgba(99,102,241,0.05)); border-bottom:1px solid rgba(99,102,241,0.2);">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#6366f1,#8b5cf6); box-shadow:0 0 16px rgba(99,102,241,0.5);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-extrabold tracking-tight" style="color:#e0e7ff;" id="st-header-title">Stage &amp; Round Timer</h2>
          <span id="st-status-badge" class="px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider" style="background:rgba(100,116,139,0.3);color:#94a3b8;border:1px solid rgba(100,116,139,0.3);">Ready</span>
        </div>
        <p class="text-[11px]" style="color:#64748b;" id="st-current-stage-desc">Track contestant stage duration, Q&amp;A limits, and round intervals.</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" id="st-btn-sound" onclick="ScoreSyncTimer.toggleSound()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-bold text-xs transition" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);color:#a5b4fc;">
        <span id="st-sound-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg></span>
        <span class="hidden sm:inline text-[11px]" id="st-sound-label">Audio On</span>
      </button>
      <button type="button" onclick="ScoreSyncTimer.toggleFullscreen()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-bold text-xs transition st-btn-primary text-white">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
        <span class="hidden sm:inline">Stage View</span>
      </button>
    </div>
  </div>

  <!-- ── CONFIG RIBBON ── -->
  <div class="relative z-10 px-5 py-3 flex flex-wrap items-center justify-between gap-3" style="background:rgba(15,17,30,0.6);border-bottom:1px solid rgba(99,102,241,0.12);">
    <div class="flex flex-wrap items-center gap-2 flex-1 min-w-[260px]">
      <label class="text-[11px] font-bold uppercase tracking-wider" style="color:#64748b;">Stage / Round:</label>
      <select id="st-stage-select" onchange="ScoreSyncTimer.onStageSelectChange(this.value)" class="px-3 py-1.5 rounded-xl font-bold text-xs focus:outline-none focus:ring-2" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.3);color:#c7d2fe;focus-ring-color:#6366f1;">
        <optgroup label="Pageant & Contest Presets">
          <option value="60" data-name="Q&amp;A Round (1 min)" selected>Q&amp;A Round &mdash; 01:00</option>
          <option value="180" data-name="Talent Showcase (3 mins)">Talent Showcase &mdash; 03:00</option>
          <option value="90" data-name="Casual Wear / Runway (1.5 mins)">Casual Wear / Runway &mdash; 01:30</option>
          <option value="120" data-name="Evening Gown / Formal (2 mins)">Evening Gown / Formal &mdash; 02:00</option>
          <option value="300" data-name="Speech / Defense (5 mins)">Speech / Defense &mdash; 05:00</option>
          <option value="120" data-name="Judge Scoring Period (2 mins)">Judge Scoring Grace &mdash; 02:00</option>
          <option value="600" data-name="Stage Intermission (10 mins)">Intermission / Break &mdash; 10:00</option>
          <option value="30" data-name="Quick Speed Round (30s)">Quick Speed Round &mdash; 00:30</option>
        </optgroup>
        <optgroup label="Custom Options">
          <option value="custom" data-name="Custom Duration">Custom Duration...</option>
        </optgroup>
      </select>
      <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-xl" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.2);">
        <span class="text-[11px] font-medium" style="color:#475569;">Contestant:</span>
        <input type="text" id="st-contestant-input" placeholder="e.g. #1 Maria Santos" class="w-32 sm:w-40 bg-transparent font-bold focus:outline-none text-xs" style="color:#c7d2fe;" placeholder-color="#475569">
      </div>
    </div>
    <div id="st-custom-controls" class="hidden items-center gap-1.5">
      <span class="text-[11px] font-bold" style="color:#64748b;">Min:</span>
      <input type="number" id="st-custom-min" min="0" max="120" value="3" class="w-12 px-2 py-1 rounded-lg text-center font-bold text-xs" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.3);color:#c7d2fe;">
      <span class="text-[11px] font-bold" style="color:#64748b;">Sec:</span>
      <input type="number" id="st-custom-sec" min="0" max="59" value="0" class="w-12 px-2 py-1 rounded-lg text-center font-bold text-xs" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.3);color:#c7d2fe;">
      <button type="button" onclick="ScoreSyncTimer.applyCustomTime()" class="px-2.5 py-1 rounded-lg text-white font-bold text-xs st-btn-primary">Set</button>
    </div>
    <div class="flex items-center gap-1">
      <button type="button" onclick="ScoreSyncTimer.adjustTime(-15)" class="px-2.5 py-1 rounded-lg font-bold text-[11px] transition" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.2);color:#94a3b8;">-15s</button>
      <button type="button" onclick="ScoreSyncTimer.adjustTime(15)"  class="px-2.5 py-1 rounded-lg font-bold text-[11px] transition" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.2);color:#94a3b8;">+15s</button>
      <button type="button" onclick="ScoreSyncTimer.adjustTime(60)"  class="px-2.5 py-1 rounded-lg font-bold text-[11px] transition" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.2);color:#94a3b8;">+1m</button>
    </div>
  </div>

  <!-- ── MAIN DISPLAY ── -->
  <div class="relative z-10 px-6 py-10 flex flex-col items-center" style="background:radial-gradient(ellipse at 50% 0%, rgba(99,102,241,0.08) 0%, transparent 70%);">

    <!-- Stage label -->
    <div class="mb-5 text-center">
      <span id="st-active-label" class="inline-block px-4 py-1.5 rounded-full text-xs font-extrabold tracking-wider uppercase" style="background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.35);color:#a5b4fc;letter-spacing:0.1em;">Q&amp;A Round (1 min)</span>
      <div id="st-contestant-display" class="text-xs font-semibold mt-2 h-4" style="color:#6366f1;"></div>
    </div>

    <!-- Ring + Digits -->
    <div class="relative flex items-center justify-center" style="width:260px;height:260px;">
      <!-- Outer glow ring -->
      <div class="absolute inset-0 rounded-full" style="background:radial-gradient(circle, rgba(99,102,241,0.08) 0%, transparent 70%);"></div>
      <!-- SVG ring -->
      <svg id="st-ring-svg" class="w-full h-full absolute inset-0 st-glow-ring" style="transform:rotate(-90deg);" viewBox="0 0 220 220">
        <circle cx="110" cy="110" r="96" fill="transparent" stroke="rgba(99,102,241,0.12)" stroke-width="10"/>
        <circle cx="110" cy="110" r="96" fill="transparent" id="st-progress-ring"
          stroke="url(#st-ring-grad)" stroke-width="10" stroke-linecap="round"
          stroke-dasharray="603.19" stroke-dashoffset="0"/>
        <defs>
          <linearGradient id="st-ring-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#6366f1"/>
            <stop offset="100%" stop-color="#a78bfa"/>
          </linearGradient>
          <linearGradient id="st-ring-grad-warn" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#f59e0b"/>
            <stop offset="100%" stop-color="#ef4444"/>
          </linearGradient>
          <linearGradient id="st-ring-grad-crit" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ef4444"/>
            <stop offset="100%" stop-color="#f43f5e"/>
          </linearGradient>
        </defs>
      </svg>
      <!-- Center content -->
      <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
        <div id="st-digits" class="font-mono font-black tracking-tighter leading-none st-digits-glow" style="font-size:3.8rem;color:#e0e7ff;">01:00</div>
        <div id="st-subtext" class="text-[11px] font-bold uppercase tracking-widest mt-2" style="color:#4f46e5;letter-spacing:0.18em;">Time Remaining</div>
        <div id="st-overtime-label" class="hidden text-xs font-black mt-1" style="color:#f43f5e;animation:st-pulse-crit 0.6s ease-in-out infinite alternate;">OVERTIME</div>
      </div>
    </div>

    <!-- Progress bar section -->
    <div class="w-full max-w-md mt-7 rounded-2xl p-4" style="background:rgba(15,17,30,0.7);border:1px solid rgba(99,102,241,0.18);">
      <div class="flex items-center justify-between text-xs font-bold mb-2.5">
        <div class="flex items-center gap-1.5">
          <span id="st-progress-dot" class="w-2 h-2 rounded-full" style="background:#6366f1;"></span>
          <span class="text-[11px] uppercase tracking-wider" style="color:#475569;">Stage Progress:</span>
          <span id="st-progress-time-ratio" class="font-mono text-xs" style="color:#c7d2fe;">00:00 / 01:00</span>
        </div>
        <span id="st-progress-percent-badge" class="px-2.5 py-0.5 rounded-full text-[11px] font-black" style="background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.35);color:#a5b4fc;">100% Left</span>
      </div>
      <!-- Track -->
      <div class="relative w-full rounded-full overflow-hidden" style="height:10px;background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.15);">
        <div id="st-linear-progress" class="h-full rounded-full relative overflow-hidden st-progress-shimmer" style="width:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6,#a78bfa);transition:width 0.3s ease-out;"></div>
      </div>
      <div class="flex items-center justify-between mt-2 px-0.5" style="font-size:10px;color:#334155;font-weight:700;">
        <span>Start</span><span class="hidden sm:inline">75%</span><span>50% (Half)</span><span class="hidden sm:inline">25%</span><span>End</span>
      </div>
    </div>

    <!-- Action buttons -->
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <button type="button" id="st-btn-reset" onclick="ScoreSyncTimer.reset()" class="flex items-center gap-1.5 px-4 py-2.5 rounded-xl font-bold text-xs transition" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.2);color:#94a3b8;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg> Reset
      </button>
      <button type="button" id="st-btn-toggle" onclick="ScoreSyncTimer.togglePlay()" class="flex items-center gap-2 px-8 py-2.5 rounded-xl font-extrabold text-sm text-white transition st-btn-primary">
        <span id="st-play-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg></span>
        <span id="st-play-label">Start Timer</span>
      </button>
      <button type="button" id="st-btn-log" onclick="ScoreSyncTimer.logAndNext()" class="flex items-center gap-1.5 px-4 py-2.5 rounded-xl font-bold text-xs transition" style="background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.3);color:#a5b4fc;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Log &amp; Next
      </button>
    </div>

  </div>

  <!-- ── STAGE LOG SECTION ── -->
  <div class="relative z-10 px-5 py-4" style="background:rgba(10,12,20,0.7);border-top:1px solid rgba(99,102,241,0.15);">
    <div class="flex items-center justify-between mb-2.5">
      <div class="flex items-center gap-2">
        <h3 class="text-xs font-bold uppercase tracking-wider" style="color:#64748b;">Completed Stage Logs</h3>
        <span id="st-log-count" class="px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(99,102,241,0.15);color:#818cf8;border:1px solid rgba(99,102,241,0.25);">0 records</span>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" onclick="ScoreSyncTimer.copyLogs()" class="flex items-center gap-1 text-[11px] font-bold transition" style="color:#475569;">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy
        </button>
        <span style="color:#1e293b;">|</span>
        <button type="button" onclick="ScoreSyncTimer.clearLogs()" class="text-[11px] font-bold transition" style="color:#475569;">Clear</button>
      </div>
    </div>
    <div id="st-log-container" class="space-y-1.5 max-h-36 overflow-y-auto pr-1">
      <div id="st-log-empty" class="text-center py-4 text-xs italic" style="color:#334155;">
        No completed stage records yet. Click &ldquo;Log &amp; Next&rdquo; when a contestant finishes their round.
      </div>
    </div>
  </div>

</div>

<!-- ── FULLSCREEN STAGE MODAL ── -->
<div id="scoresync-fullscreen-modal" class="hidden fixed inset-0 flex-col items-center justify-between p-6 sm:p-12" style="z-index:9999;background:linear-gradient(135deg,#050711 0%,#0a0d1a 50%,#050711 100%);">
  <!-- Top bar -->
  <div class="w-full flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-2xl flex items-center justify-center" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 0 20px rgba(99,102,241,0.5);">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
      </div>
      <div>
        <h1 class="text-xl font-black tracking-tight" style="color:#e0e7ff;">ScoreSync Stage Timer</h1>
        <p class="text-xs" style="color:#4f46e5;" id="st-fs-stage-sub">Official Competition Stage Display</p>
      </div>
    </div>
    <button type="button" onclick="ScoreSyncTimer.toggleFullscreen()" class="flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs transition" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.25);color:#94a3b8;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Exit (ESC)
    </button>
  </div>

  <!-- Center display -->
  <div class="flex flex-col items-center justify-center my-auto text-center w-full max-w-4xl">
    <div id="st-fs-contestant" class="text-2xl sm:text-3xl font-extrabold min-h-[36px] mb-3" style="color:#6366f1;text-shadow:0 0 20px rgba(99,102,241,0.5);"></div>
    <div id="st-fs-stage-name" class="inline-block px-5 py-1.5 rounded-full text-sm font-extrabold mb-6" style="background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.35);color:#a5b4fc;">Q&amp;A Round (1 min)</div>
    <div id="st-fs-digits" class="font-mono font-black tracking-tighter leading-none select-none st-digits-glow" style="font-size:clamp(6rem,22vw,16rem);color:#e0e7ff;">01:00</div>
    <div id="st-fs-status" class="text-sm sm:text-lg font-bold tracking-widest uppercase mt-6" style="color:#4f46e5;">Ready &bull; Press Spacebar to Start</div>

    <!-- FS Progress -->
    <div class="w-full max-w-2xl mt-8 rounded-2xl p-5" style="background:rgba(15,17,30,0.8);border:1px solid rgba(99,102,241,0.2);">
      <div class="flex items-center justify-between text-xs font-bold mb-3">
        <div class="flex items-center gap-2">
          <span id="st-fs-progress-dot" class="w-2.5 h-2.5 rounded-full" style="background:#6366f1;"></span>
          <span class="uppercase tracking-widest text-[11px] font-extrabold" style="color:#334155;">Elapsed / Total:</span>
          <span id="st-fs-progress-time-ratio" class="font-mono font-black" style="color:#e0e7ff;font-size:0.9rem;">00:00 / 01:00</span>
        </div>
        <span id="st-fs-progress-percent" class="px-3 py-1 rounded-full text-xs font-black" style="background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.35);color:#a5b4fc;">100% Left</span>
      </div>
      <div class="w-full rounded-full overflow-hidden" style="height:20px;background:rgba(15,17,30,0.9);border:1px solid rgba(99,102,241,0.2);">
        <div id="st-fs-progress" class="h-full rounded-full st-progress-shimmer" style="width:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6,#a78bfa);transition:width 0.3s ease-out;"></div>
      </div>
      <div class="flex items-center justify-between mt-2 px-1 text-[11px] font-extrabold" style="color:#1e293b;">
        <span>Start</span><span>75%</span><span>50% (Half)</span><span>25%</span><span>End</span>
      </div>
    </div>
  </div>

  <!-- FS bottom controls -->
  <div class="w-full flex flex-wrap items-center justify-center gap-4 pt-6" style="border-top:1px solid rgba(99,102,241,0.15);">
    <button type="button" onclick="ScoreSyncTimer.reset()" class="px-5 py-3 rounded-xl font-bold text-sm transition" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.2);color:#94a3b8;">Reset</button>
    <button type="button" onclick="ScoreSyncTimer.togglePlay()" id="st-fs-btn-toggle" class="flex items-center gap-2 px-10 py-3 rounded-xl font-black text-base text-white transition st-btn-primary">
      <span id="st-fs-play-label">Start Timer</span>
    </button>
    <button type="button" onclick="ScoreSyncTimer.adjustTime(30)" class="px-4 py-3 rounded-xl font-bold text-sm transition" style="background:rgba(30,32,48,0.9);border:1px solid rgba(99,102,241,0.2);color:#94a3b8;">+30s</button>
    <button type="button" onclick="ScoreSyncTimer.logAndNext()" class="px-5 py-3 rounded-xl font-bold text-sm transition text-white" style="background:linear-gradient(135deg,#059669,#10b981);box-shadow:0 4px 16px rgba(16,185,129,0.3);">Log &amp; Next Stage</button>
  </div>
</div>

<!-- ── TIMER ENGINE SCRIPT ── -->
<script>
window.ScoreSyncTimer = (function() {
  const CIRCUMFERENCE = 603.19; // 2 * Math.PI * 96
  let totalDuration = 60, remainingSeconds = 60;
  let isRunning = false, intervalId = null, soundEnabled = true;
  let logs = [], stageName = "Q&A Round (1 min)", audioCtx = null;

  function getAudioCtx() {
    if (!audioCtx) { const A = window.AudioContext||window.webkitAudioContext; if(A) audioCtx = new A(); }
    if (audioCtx && audioCtx.state==='suspended') audioCtx.resume();
    return audioCtx;
  }
  function playTone(freq,type,dur,delay=0) {
    if (!soundEnabled) return;
    try { const ctx=getAudioCtx(); if(!ctx) return;
      setTimeout(()=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type=type||'sine';o.frequency.setValueAtTime(freq,ctx.currentTime);g.gain.setValueAtTime(0.2,ctx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+dur);o.connect(g);g.connect(ctx.destination);o.start();o.stop(ctx.currentTime+dur);},delay);
    } catch(e){}
  }
  function playWarn() { playTone(660,'sine',0.15); }
  function playBuzz() { playTone(880,'square',0.2,0);playTone(880,'square',0.2,220);playTone(880,'square',0.45,440); }
  function fmt(s) { const neg=s<0,a=Math.abs(s),m=Math.floor(a/60),sc=a%60,p=n=>String(n).padStart(2,'0'); return (neg?'+':'')+p(m)+':'+p(sc); }

  function applyRingStyle(ringEl, svgEl, state) {
    const grad = state==='warn'?'url(#st-ring-grad-warn)':state==='crit'?'url(#st-ring-grad-crit)':'url(#st-ring-grad)';
    if (ringEl) ringEl.setAttribute('stroke', grad);
    if (svgEl) { svgEl.className.baseVal = svgEl.className.baseVal.replace(/st-glow-ring\S*/g,'').trim(); svgEl.classList.add(state==='crit'?'st-glow-ring-crit':state==='warn'?'st-glow-ring-warn':'st-glow-ring'); }
  }

  function updateUI() {
    const D=id=>document.getElementById(id);
    const digits=D('st-digits'), fsDigits=D('st-fs-digits'), subtext=D('st-subtext'), badge=D('st-status-badge');
    const ring=D('st-progress-ring'), ringsvg=D('st-ring-svg'), linEl=D('st-linear-progress'), fsLin=D('st-fs-progress');
    const otLabel=D('st-overtime-label'), fsStat=D('st-fs-status');
    const cInput=D('st-contestant-input'), cDisp=D('st-contestant-display'), fsCont=D('st-fs-contestant');
    const activeLabel=D('st-active-label'), fsStage=D('st-fs-stage-name');
    const timeRatio=D('st-progress-time-ratio'), pctBadge=D('st-progress-percent-badge'), dot=D('st-progress-dot');
    const fsRatio=D('st-fs-progress-time-ratio'), fsPct=D('st-fs-progress-percent'), fsDot=D('st-fs-progress-dot');

    const formatted = fmt(remainingSeconds);
    if (digits) digits.textContent = formatted;
    if (fsDigits) fsDigits.textContent = formatted;
    const ct = cInput ? cInput.value.trim() : '';
    if (cDisp) cDisp.textContent = ct ? `Active: ${ct}` : '';
    if (fsCont) fsCont.textContent = ct ? `Active: ${ct}` : '';
    if (activeLabel) activeLabel.textContent = stageName;
    if (fsStage) fsStage.textContent = stageName;

    const frac = totalDuration>0 ? Math.max(0,Math.min(1,remainingSeconds/totalDuration)) : 0;
    const pct = Math.round(frac*100);
    const elapsed = Math.max(0,totalDuration-remainingSeconds);
    const ratio = `${fmt(elapsed)} / ${fmt(totalDuration)}`;
    if (timeRatio) timeRatio.textContent = ratio;
    if (fsRatio) fsRatio.textContent = ratio;
    if (ring) ring.style.strokeDashoffset = CIRCUMFERENCE-(frac*CIRCUMFERENCE);

    // State-based styling
    let state = remainingSeconds<0 ? 'crit' : remainingSeconds<=10 ? 'warn' : pct<=25 ? 'quarter' : 'normal';
    applyRingStyle(ring, ringsvg, state==='crit'||state==='warn'?state:'normal');

    const colors = {
      crit:    { bar:'linear-gradient(90deg,#ef4444,#f43f5e)', dot:'#ef4444', badgeBg:'rgba(239,68,68,0.2)', badgeBorder:'rgba(239,68,68,0.4)', badgeColor:'#fca5a5', digits:'#fca5a5', digitsShadow:'0 0 30px rgba(239,68,68,0.6)', badgeBgBadge:'rgba(239,68,68,0.15)' },
      warn:    { bar:'linear-gradient(90deg,#f59e0b,#ef4444)', dot:'#f59e0b', badgeBg:'rgba(245,158,11,0.2)', badgeBorder:'rgba(245,158,11,0.4)', badgeColor:'#fcd34d', digits:'#fcd34d', digitsShadow:'0 0 30px rgba(245,158,11,0.6)', badgeBgBadge:'rgba(245,158,11,0.15)' },
      quarter: { bar:'linear-gradient(90deg,#f59e0b,#fb923c)', dot:'#f59e0b', badgeBg:'rgba(245,158,11,0.15)', badgeBorder:'rgba(245,158,11,0.3)', badgeColor:'#fcd34d', digits:'#e0e7ff', digitsShadow:'0 0 30px rgba(99,102,241,0.5)', badgeBgBadge:'rgba(245,158,11,0.12)' },
      normal:  { bar:'linear-gradient(90deg,#6366f1,#8b5cf6,#a78bfa)', dot:'#6366f1', badgeBg:'rgba(99,102,241,0.2)', badgeBorder:'rgba(99,102,241,0.35)', badgeColor:'#a5b4fc', digits:'#e0e7ff', digitsShadow:'0 0 30px rgba(99,102,241,0.5)', badgeBgBadge:'rgba(99,102,241,0.15)' },
    };
    const c = colors[state] || colors.normal;
    const barW = state==='crit' ? '100%' : `${pct}%`;

    if (linEl) { linEl.style.background=c.bar; linEl.style.width=barW; }
    if (fsLin) { fsLin.style.background=c.bar; fsLin.style.width=barW; }
    if (digits) { digits.style.color=c.digits; digits.style.textShadow=c.digitsShadow; }
    if (fsDigits) { fsDigits.style.color=c.digits; fsDigits.style.textShadow=c.digitsShadow; }
    if (dot) dot.style.background = c.dot;
    if (fsDot) fsDot.style.background = c.dot;

    const pctText = state==='crit' ? `Overtime (+${Math.abs(remainingSeconds)}s)` : `${pct}% Left`;
    const fsPctText = state==='crit' ? `OVERTIME` : `${pct}% REMAINING`;
    [pctBadge,fsPct].forEach((el,i)=>{ if(el){ el.textContent=i?fsPctText:pctText; el.style.background=c.badgeBg; el.style.borderColor=c.badgeBorder; el.style.color=c.badgeColor; }});

    if (otLabel) otLabel.classList.toggle('hidden', state!=='crit');
    if (subtext) subtext.textContent = state==='crit' ? 'Elapsed Overtime' : 'Time Remaining';

    // Status badge
    const running = isRunning;
    if (badge) {
      if (state==='crit') { badge.textContent='OVERTIME'; badge.style.cssText='background:rgba(239,68,68,0.25);border:1px solid rgba(239,68,68,0.5);color:#fca5a5;'; }
      else if (state==='warn') { badge.textContent='FINAL 10s'; badge.style.cssText='background:rgba(245,158,11,0.25);border:1px solid rgba(245,158,11,0.5);color:#fcd34d;'; }
      else if (running) { badge.textContent='RUNNING'; badge.style.cssText='background:rgba(16,185,129,0.2);border:1px solid rgba(16,185,129,0.4);color:#6ee7b7;'; }
      else if (remainingSeconds===totalDuration) { badge.textContent='READY'; badge.style.cssText='background:rgba(100,116,139,0.25);border:1px solid rgba(100,116,139,0.3);color:#94a3b8;'; }
      else { badge.textContent='PAUSED'; badge.style.cssText='background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.3);color:#fcd34d;'; }
    }
    if (fsStat) fsStat.textContent = running ? 'STAGE IN PROGRESS \u2022 SPACEBAR TO PAUSE' : 'READY \u2022 PRESS SPACEBAR TO START';

    // Play/pause labels
    const pi=document.getElementById('st-play-icon'), pl=document.getElementById('st-play-label'), fpl=document.getElementById('st-fs-play-label');
    if (running) {
      if(pl) pl.textContent='Pause'; if(fpl) fpl.textContent='Pause Timer';
      if(pi) pi.innerHTML='<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
    } else {
      if(pl) pl.textContent=remainingSeconds===totalDuration?'Start Timer':'Resume'; if(fpl) fpl.textContent=remainingSeconds===totalDuration?'Start Timer':'Resume';
      if(pi) pi.innerHTML='<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>';
    }
  }

  function tick() {
    remainingSeconds--;
    if (remainingSeconds===10) playWarn();
    else if ([3,2,1].includes(remainingSeconds)) playTone(440,'sine',0.1);
    else if (remainingSeconds===0) playBuzz();
    updateUI();
  }
  function start() { getAudioCtx(); if(isRunning) return; isRunning=true; intervalId=setInterval(tick,1000); updateUI(); }
  function pause() { if(!isRunning) return; isRunning=false; clearInterval(intervalId); intervalId=null; updateUI(); }
  function togglePlay() { isRunning?pause():start(); }
  function reset() { pause(); remainingSeconds=totalDuration; updateUI(); }
  function adjustTime(d) { getAudioCtx(); remainingSeconds+=d; totalDuration=Math.max(totalDuration,remainingSeconds); updateUI(); }
  function setDuration(s,name) { pause(); totalDuration=s; remainingSeconds=s; if(name) stageName=name; updateUI(); }

  function onStageSelectChange(val) {
    const sel=document.getElementById('st-stage-select'), cd=document.getElementById('st-custom-controls');
    if (val==='custom') { cd&&cd.classList.remove('hidden'); cd&&cd.classList.add('flex'); }
    else { cd&&(cd.classList.add('hidden'),cd.classList.remove('flex')); const o=sel.options[sel.selectedIndex]; setDuration(parseInt(val,10),o.getAttribute('data-name')||o.text); }
  }
  function applyCustomTime() {
    const m=parseInt(document.getElementById('st-custom-min')?.value||0,10)||0;
    const s=parseInt(document.getElementById('st-custom-sec')?.value||0,10)||0;
    const t=m*60+s; if(t>0) setDuration(t,`Custom (${m}m ${s}s)`);
  }
  function toggleSound() {
    soundEnabled=!soundEnabled;
    const lbl=document.getElementById('st-sound-label'), ico=document.getElementById('st-sound-icon');
    if (soundEnabled) { getAudioCtx(); if(lbl) lbl.textContent='Audio On'; if(ico) ico.innerHTML='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>'; playTone(520,'sine',0.1); }
    else { if(lbl) lbl.textContent='Audio Off'; if(ico) ico.innerHTML='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>'; }
  }
  function toggleFullscreen() {
    const m=document.getElementById('scoresync-fullscreen-modal'); if(!m) return; getAudioCtx();
    const hidden=m.classList.contains('hidden');
    m.classList.toggle('hidden',!hidden); m.classList.toggle('flex',hidden);
    document.body.style.overflow=hidden?'hidden':'';
    if (hidden&&document.documentElement.requestFullscreen&&!document.fullscreenElement) document.documentElement.requestFullscreen().catch(()=>{});
    else if (!hidden&&document.exitFullscreen&&document.fullscreenElement) document.exitFullscreen().catch(()=>{});
    updateUI();
  }
  function logAndNext() {
    getAudioCtx();
    const ci=document.getElementById('st-contestant-input');
    const contestant=ci?ci.value.trim()||'General Stage':'General Stage';
    const elapsed=totalDuration-remainingSeconds, now=new Date();
    const ts=now.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    const isOT=remainingSeconds<0;
    logs.unshift({ id:Date.now(), stage:stageName, contestant, allocated:fmt(totalDuration), elapsed:fmt(elapsed), statusText:isOT?`Overtime (+${Math.abs(remainingSeconds)}s)`:'On Time', statusClass:isOT?'crit':'ok', timestamp:ts });
    renderLogs(); reset();
    if (ci&&ci.value) { const m=ci.value.match(/(.*?)(\d+)(.*)/); if(m) ci.value=`${m[1]}${parseInt(m[2],10)+1}${m[3]}`; }
    updateUI();
  }
  function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function renderLogs() {
    const c=document.getElementById('st-log-container'), cb=document.getElementById('st-log-count');
    if(!c) return;
    if(cb) cb.textContent=`${logs.length} records`;
    if (!logs.length) { c.innerHTML='<div id="st-log-empty" class="text-center py-4 text-xs italic" style="color:#334155;">No completed stage records yet.</div>'; return; }
    c.innerHTML=logs.map(l=>`
      <div class="flex items-center justify-between p-2 rounded-xl text-xs" style="background:rgba(15,17,30,0.8);border:1px solid rgba(99,102,241,0.15);">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full" style="background:#6366f1;"></span>
          <span class="font-bold" style="color:#c7d2fe;">${esc(l.contestant)}</span>
          <span style="color:#334155;">&bull;</span>
          <span style="color:#64748b;">${esc(l.stage)}</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono font-bold" style="color:#94a3b8;">${l.elapsed} / ${l.allocated}</span>
          <span class="px-2 py-0.5 rounded-md text-[10px] font-bold" style="background:${l.statusClass==='crit'?'rgba(239,68,68,0.15)':'rgba(16,185,129,0.15)'};border:1px solid ${l.statusClass==='crit'?'rgba(239,68,68,0.3)':'rgba(16,185,129,0.3)'};color:${l.statusClass==='crit'?'#fca5a5':'#6ee7b7'};">${l.statusText}</span>
          <span class="font-mono text-[10px]" style="color:#334155;">${l.timestamp}</span>
        </div>
      </div>`).join('');
  }
  function copyLogs() {
    if(!logs.length){alert("No logs yet.");return;}
    const lines=logs.map(l=>`[${l.timestamp}] ${l.contestant} - ${l.stage}: ${l.elapsed}/${l.allocated} (${l.statusText})`);
    navigator.clipboard.writeText(lines.join('\n')).then(()=>alert("Copied!")).catch(()=>alert("Logs:\n"+lines.join('\n')));
  }
  function clearLogs(){ if(logs.length&&confirm("Clear all logs?")){ logs=[]; renderLogs(); } }

  document.addEventListener('keydown',e=>{
    const t=e.target.tagName; if(t==='INPUT'||t==='TEXTAREA'||t==='SELECT') return;
    if(e.code==='Space'){e.preventDefault();togglePlay();}
    else if(e.code==='Escape'){const m=document.getElementById('scoresync-fullscreen-modal');if(m&&!m.classList.contains('hidden'))toggleFullscreen();}
  });
  document.addEventListener('DOMContentLoaded',()=>updateUI());

  return { start,pause,togglePlay,reset,adjustTime,setDuration,onStageSelectChange,applyCustomTime,toggleSound,toggleFullscreen,logAndNext,copyLogs,clearLogs };
})();
</script>
