{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0b0f1e;color:#e2e8f0;">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="flex items-center gap-3 p-4 rounded-2xl text-sm font-semibold" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="flex items-center gap-3 p-4 rounded-2xl text-sm font-semibold" style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg>{{error_msg}}</div>{{/if}}

  <!-- Header -->
  <div class="rounded-2xl p-6 sm:p-8 relative overflow-hidden" style="background:linear-gradient(135deg,#1e1b4b 0%,#312e81 60%,#4c1d95 100%);">
    <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at 80% 50%,rgba(139,92,246,0.15) 0%,transparent 65%);"></div>
    <div class="relative z-10">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider" style="background:rgba(139,92,246,0.25);border:1px solid rgba(139,92,246,0.4);color:#c4b5fd;">Official Judge Panel</span>
        <span class="flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold" style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;">
          <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-ping inline-block"></span> Active
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight" style="color:#e0e7ff;">Welcome, <span style="color:#c4b5fd;">{{userName}}</span> 👋</h1>
      <p class="text-sm mt-1" style="color:#475569;">Select an assigned event below to submit official scores per contestant.</p>
    </div>
  </div>

  <!-- Instruction Banner -->
  <div class="flex items-start gap-4 p-5 rounded-2xl" style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2);">
    <div class="w-10 h-10 rounded-2xl flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#4c1d95,#7c3aed);">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <div>
      <h3 class="font-extrabold text-sm" style="color:#e0e7ff;">Scoring Guidelines</h3>
      <p class="text-xs font-medium mt-0.5 leading-relaxed" style="color:#6366f1;">
        Click <span class="px-2 py-0.5 rounded font-bold text-[11px] text-white" style="background:#7c3aed;">Score Now</span> on active events. Ensure scores adhere strictly to official percentage weights (0–100%).
      </p>
    </div>
  </div>

  <!-- Events List -->
  <div class="rounded-2xl overflow-hidden" style="background:rgba(12,15,30,0.95);border:1px solid rgba(99,102,241,0.18);">
    <div class="px-6 py-4 flex items-center gap-2.5" style="border-bottom:1px solid rgba(99,102,241,0.15);">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(139,92,246,0.2);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c4b5fd" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <h2 class="text-sm font-extrabold" style="color:#e0e7ff;">Events Available for Scoring</h2>
    </div>

    {{#if recentEvents.length}}
    <div>
      {{#each recentEvents}}
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-6 py-4 transition" style="border-bottom:1px solid rgba(99,102,241,0.08);" onmouseover="this.style.background='rgba(99,102,241,0.05)'" onmouseout="this.style.background='transparent'">
        <div class="flex items-center gap-4">
          <div class="w-11 h-11 rounded-2xl flex items-center justify-center flex-shrink-0 text-white" style="background:linear-gradient(135deg,#4c1d95,#7c3aed);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-base" style="color:#e0e7ff;">{{name}}</h3>
            <p class="text-xs mt-0.5" style="color:#334155;">
              {{#if venue}}<span>{{venue}}</span> &bull; {{/if}}<span>{{date}}</span>
            </p>
          </div>
        </div>
        <div class="flex items-center gap-3 self-end sm:self-center">
          <span class="px-2.5 py-1 rounded-full text-[11px] font-black capitalize
            {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}badge-yellow{{/if}}{{/if}}">
            {{status}}
          </span>
          {{#if (eq status 'ongoing')}}
          <a href="/events/{{id}}/scoring" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs text-white transition" style="background:linear-gradient(135deg,#6d28d9,#7c3aed);box-shadow:0 4px 14px rgba(124,58,237,0.3);">
            Score Now <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          {{else}}
          <a href="/events/{{id}}/results" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs transition" style="background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.25);color:#a5b4fc;">
            View Results
          </a>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="py-16 flex flex-col items-center justify-center text-center">
      <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-4" style="background:rgba(139,92,246,0.1);border:1px solid rgba(139,92,246,0.2);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </div>
      <p class="font-bold" style="color:#475569;">No Scoring Events Available</p>
      <p class="text-xs mt-1 max-w-sm" style="color:#334155;">Contact the administrator to assign scoring events to your account.</p>
    </div>
    {{/if}}
  </div>

</main>
</div>
{{> footer }}
</body>
</html>
