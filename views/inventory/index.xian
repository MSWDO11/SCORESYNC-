{{> head }}
<body class="min-h-screen flex flex-col bg-slate-50">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6">

  <!-- Header -->
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight">Payment Inventory</h1>
      <p class="text-sm text-slate-500 mt-0.5">Track all ticket & payment records for concerts, festivals, and other ticketed events.</p>
    </div>
    <button onclick="document.getElementById('addModal').classList.remove('hidden')"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-bold text-sm shadow-md transition"
      style="background:linear-gradient(135deg,#0f766e,#14b8a6);box-shadow:0 4px 16px rgba(20,184,166,0.35);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Payment Record
    </button>
  </div>

  <!-- Flash messages -->
  {{#if success_msg}}
  <div class="flex items-center gap-2.5 p-3.5 rounded-xl text-sm font-semibold bg-emerald-50 border border-emerald-200 text-emerald-800">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
    {{success_msg}}
  </div>
  {{/if}}
  {{#if error_msg}}
  <div class="flex items-center gap-2.5 p-3.5 rounded-xl text-sm font-semibold bg-red-50 border border-red-200 text-red-800">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    {{error_msg}}
  </div>
  {{/if}}

  <!-- KPI Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg,#064e3b,#10b981);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total Revenue</span>
      </div>
      <div class="text-2xl font-black text-slate-900">₱{{totalRevenue}}</div>
      <div class="text-xs text-slate-400 mt-1">{{recordCount}} payment record(s)</div>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg,#0f766e,#14b8a6);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/></svg>
        </div>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tickets Sold</span>
      </div>
      <div class="text-2xl font-black text-slate-900">{{totalTickets}}</div>
      <div class="text-xs text-slate-400 mt-1">Across all events</div>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Confirmed</span>
      </div>
      <div class="text-2xl font-black text-slate-900">{{confirmedCount}}</div>
      <div class="text-xs text-slate-400 mt-1">Confirmed payments</div>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg,#92400e,#f59e0b);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Pending</span>
      </div>
      <div class="text-2xl font-black text-slate-900">{{pendingCount}}</div>
      <div class="text-xs text-slate-400 mt-1">Awaiting confirmation</div>
    </div>
  </div>

  <!-- Per-event Revenue Summary -->
  {{#if eventSummary.length}}
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:rgba(20,184,166,0.15);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0f766e" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </div>
      <h2 class="text-sm font-extrabold text-slate-800">Revenue by Event</h2>
    </div>
    <div class="divide-y divide-slate-100">
      {{#each eventSummary}}
      <div class="flex items-center justify-between px-6 py-3.5 hover:bg-slate-50 transition">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(20,184,166,0.1);">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0f766e" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/></svg>
          </div>
          <div>
            <div class="text-sm font-bold text-slate-800">{{eventName}}</div>
            <div class="text-xs text-slate-400">{{count}} record(s) &bull; {{tickets}} ticket(s)</div>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="font-black text-emerald-700 text-base">₱<span data-fmt="{{revenue}}">{{revenue}}</span></span>
          <a href="/inventory?event={{eventId}}" class="px-3 py-1 rounded-lg text-xs font-bold transition" style="background:rgba(20,184,166,0.1);color:#0f766e;">Filter</a>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <!-- Filter Bar -->
  <div class="flex flex-wrap items-center gap-3">
    <form method="GET" action="/inventory" class="flex items-center gap-2">
      <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Filter by Event:</label>
      <select name="event" onchange="this.form.submit()" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-400">
        <option value="">All Events</option>
        {{#each allEvents}}
        <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
      {{#if filterEventId}}
      <a href="/inventory" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-500 hover:text-red-600 border border-slate-200 bg-white transition">✕ Clear</a>
      {{/if}}
    </form>
    <span class="text-xs text-slate-400 ml-auto">{{recordCount}} record(s) shown</span>
  </div>

  <!-- Records Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:rgba(20,184,166,0.15);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0f766e" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      </div>
      <h2 class="text-sm font-extrabold text-slate-800">Payment Records</h2>
    </div>

    {{#if records.length}}
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-max">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-[11px] font-extrabold text-slate-400 uppercase tracking-wider">
            <th class="py-3 px-5">Event</th>
            <th class="py-3 px-4">Payer</th>
            <th class="py-3 px-4 text-center">Qty</th>
            <th class="py-3 px-4 text-right">Unit Price</th>
            <th class="py-3 px-4 text-right">Total</th>
            <th class="py-3 px-4">Method</th>
            <th class="py-3 px-4">Reference</th>
            <th class="py-3 px-4 text-center">Status</th>
            <th class="py-3 px-4">Recorded By</th>
            <th class="py-3 px-4">Date</th>
            <th class="py-3 px-4 text-center">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          {{#each records}}
          <tr class="hover:bg-slate-50 transition group">
            <td class="py-3 px-5">
              <span class="font-bold text-slate-800 text-xs">{{eventName}}</span>
            </td>
            <td class="py-3 px-4 font-semibold text-slate-700">{{payerName}}</td>
            <td class="py-3 px-4 text-center font-bold text-slate-700">{{quantity}}</td>
            <td class="py-3 px-4 text-right font-semibold text-slate-600 text-xs">₱{{unitPrice}}</td>
            <td class="py-3 px-4 text-right font-black text-emerald-700">₱<span data-fmt="{{total}}">{{total}}</span></td>
            <td class="py-3 px-4">
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold
                {{#if (eq method 'GCash')}}bg-blue-50 text-blue-700 border border-blue-200
                {{else}}{{#if (eq method 'InstaPay')}}bg-teal-50 text-teal-700 border border-teal-200
                {{else}}{{#if (eq method 'Maya')}}bg-green-50 text-green-700 border border-green-200
                {{else}}bg-slate-100 text-slate-600 border border-slate-200{{/if}}{{/if}}{{/if}}">
                {{method}}
              </span>
            </td>
            <td class="py-3 px-4 font-mono text-xs text-slate-500">{{reference}}</td>
            <td class="py-3 px-4 text-center">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-black
                {{#if (eq status 'Confirmed')}}bg-emerald-50 text-emerald-700 border border-emerald-200
                {{else}}{{#if (eq status 'Pending')}}bg-amber-50 text-amber-700 border border-amber-200
                {{else}}bg-red-50 text-red-700 border border-red-200{{/if}}{{/if}}">
                {{status}}
              </span>
            </td>
            <td class="py-3 px-4 text-xs text-slate-500">{{recordedBy}}</td>
            <td class="py-3 px-4 text-xs text-slate-400 font-mono whitespace-nowrap">{{createdAt}}</td>
            <td class="py-3 px-4 text-center">
              <form method="POST" action="/inventory/{{id}}/delete" onsubmit="return confirm('Delete this record?')">
                <button type="submit" class="p-1.5 rounded-lg hover:bg-red-50 text-slate-300 hover:text-red-500 transition">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                </button>
              </form>
            </td>
          </tr>
          {{/each}}
        </tbody>
        <tfoot class="border-t-2 border-slate-200 bg-slate-50">
          <tr>
            <td colspan="4" class="py-3 px-5 text-xs font-extrabold text-slate-500 uppercase tracking-wider text-right">Total</td>
            <td class="py-3 px-4 text-right font-black text-emerald-700">₱{{totalRevenue}}</td>
            <td colspan="6"></td>
          </tr>
        </tfoot>
      </table>
    </div>
    {{else}}
    <div class="py-20 flex flex-col items-center justify-center text-center">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4 bg-slate-100">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/></svg>
      </div>
      <p class="font-bold text-slate-500">No payment records yet.</p>
      <p class="text-sm text-slate-400 mt-1">Click <strong>Add Payment Record</strong> to log the first entry.</p>
    </div>
    {{/if}}
  </div>

</main>
</div>

<!-- ── ADD PAYMENT RECORD MODAL ── -->
<div id="addModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between" style="background:linear-gradient(135deg,#0f766e,#14b8a6);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <h2 class="font-extrabold text-white text-base">Add Payment Record</h2>
      </div>
      <button onclick="document.getElementById('addModal').classList.add('hidden')" class="text-white/70 hover:text-white transition">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form method="POST" action="/inventory" class="px-6 py-5 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Event <span class="text-red-500">*</span></label>
          <select name="eventId" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-teal-400">
            <option value="">— Select ticketed event —</option>
            {{#each allEvents}}
            <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Payer Name</label>
          <input type="text" name="payerName" placeholder="e.g. Juan dela Cruz or Walk-in" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400"/>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Quantity <span class="text-red-500">*</span></label>
          <input type="number" name="quantity" min="1" value="1" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" id="qtyInput" oninput="calcTotal()"/>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Unit Price (₱) <span class="text-red-500">*</span></label>
          <input type="number" name="unitPrice" min="0" step="0.01" placeholder="0.00" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" id="priceInput" oninput="calcTotal()"/>
        </div>
        <!-- Live total preview -->
        <div class="col-span-2 flex items-center justify-between px-4 py-2.5 rounded-xl" style="background:rgba(20,184,166,0.08);border:1px solid rgba(20,184,166,0.2);">
          <span class="text-xs font-bold text-teal-700">Total Amount</span>
          <span class="font-black text-teal-800 text-lg" id="totalPreview">₱0.00</span>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Payment Method</label>
          <select name="method" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-teal-400">
            <option value="Cash">Cash</option>
            <option value="GCash">GCash</option>
            <option value="InstaPay">InstaPay</option>
            <option value="Maya">Maya</option>
            <option value="Bank Transfer">Bank Transfer</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Status</label>
          <select name="status" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-teal-400">
            <option value="Confirmed">Confirmed</option>
            <option value="Pending">Pending</option>
            <option value="Cancelled">Cancelled</option>
          </select>
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Reference / Transaction No.</label>
          <input type="text" name="reference" placeholder="e.g. GCash ref #1234ABCD" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400"/>
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Notes</label>
          <textarea name="notes" rows="2" placeholder="Optional notes..." class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-teal-400"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-3 pt-2">
        <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-50 transition">Cancel</button>
        <button type="submit" class="px-6 py-2.5 rounded-xl text-white font-extrabold text-sm shadow-md transition" style="background:linear-gradient(135deg,#0f766e,#14b8a6);box-shadow:0 4px 14px rgba(20,184,166,0.35);">Save Record</button>
      </div>
    </form>
  </div>
</div>

<script>
  function calcTotal() {
    const qty   = parseFloat(document.getElementById('qtyInput').value)   || 0;
    const price = parseFloat(document.getElementById('priceInput').value) || 0;
    const total = qty * price;
    document.getElementById('totalPreview').textContent = '₱' + total.toLocaleString('en-PH', {minimumFractionDigits:2, maximumFractionDigits:2});
  }
  // Format revenue cells
  document.querySelectorAll('[data-fmt]').forEach(el => {
    const v = parseFloat(el.getAttribute('data-fmt')) || 0;
    el.textContent = v.toLocaleString('en-PH', {minimumFractionDigits:2, maximumFractionDigits:2});
  });
  // Re-open modal if there was a validation error (no records added)
  {{#if error_msg}}
  document.getElementById('addModal').classList.remove('hidden');
  {{/if}}
</script>

{{> footer }}
</body>
</html>
