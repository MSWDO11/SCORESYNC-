<div id="sidebar-overlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden transition-opacity"></div>

<nav class="h-14 flex items-center px-3 sm:px-5 gap-2.5 sticky top-0 z-30 flex-shrink-0"
  style="background:linear-gradient(90deg,#060e22 0%,#0b1a45 50%,#0f2462 100%);border-bottom:1px solid rgba(255,255,255,0.07);box-shadow:0 2px 20px rgba(0,0,0,0.35);">

  <!-- Mobile Hamburger Toggle -->
  <button type="button" onclick="toggleMobileSidebar()"
    class="md:hidden p-2 rounded-xl transition flex-shrink-0"
    style="color:rgba(255,255,255,0.6);"
    onmouseover="this.style.background='rgba(255,255,255,0.1)';this.style.color='#fff'"
    onmouseout="this.style.background='transparent';this.style.color='rgba(255,255,255,0.6)'"
    aria-label="Toggle Navigation Menu">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <!-- Brand -->
  <a href="/dashboard" class="flex items-center gap-2 flex-shrink-0 group">
    <div class="w-7 h-7 grad-gold rounded-lg flex items-center justify-center shadow-md">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
    </div>
    <span class="font-black text-sm tracking-tight hidden sm:block" style="color:#e0e7ff;">ScoreSync</span>
  </a>

  <!-- Breadcrumb -->
  <div class="hidden lg:flex items-center gap-1.5 text-sm flex-shrink-0 ml-1" style="color:rgba(255,255,255,0.35);">
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    <span style="color:rgba(255,255,255,0.55);font-size:0.82rem;font-weight:500;">{{ title }}</span>
  </div>

  <!-- Right Actions -->
  <div class="flex items-center gap-2 sm:gap-2.5 ml-auto flex-shrink-0">

    <!-- Settings -->
    <a href="/settings" title="Settings"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition"
      style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);"
      onmouseover="this.style.background='rgba(255,255,255,0.12)';this.style.color='#fff'"
      onmouseout="this.style.background='rgba(255,255,255,0.07)';this.style.color='rgba(255,255,255,0.6)'">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
      <span class="hidden sm:inline">Settings</span>
    </a>

    <!-- Role badge -->
    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold"
      style="{{#if isAdmin}}background:rgba(59,130,246,0.18);border:1px solid rgba(59,130,246,0.35);color:#93c5fd;{{else}}{{#if isJudge}}background:rgba(139,92,246,0.18);border:1px solid rgba(139,92,246,0.35);color:#c4b5fd;{{else}}background:rgba(16,185,129,0.18);border:1px solid rgba(16,185,129,0.35);color:#6ee7b7;{{/if}}{{/if}}">
      {{#if isAdmin}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6.5 1-4.8 4.5 1.2 6.5L12 16l-5.9 3 1.2-6.5L2.5 8 9 7z"/></svg>
      {{else}}{{#if isJudge}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      {{else}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/></svg>
      {{/if}}{{/if}}
      <span class="capitalize">{{userRole}}</span>
    </span>

    <!-- Profile Pill -->
    <a href="/settings"
      class="flex items-center gap-2 pl-1 pr-3 py-1 rounded-full transition group"
      style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);"
      onmouseover="this.style.background='rgba(255,255,255,0.14)'"
      onmouseout="this.style.background='rgba(255,255,255,0.08)'">
      <div class="w-7 h-7 rounded-full grad-brand flex items-center justify-center text-white text-xs font-black shadow flex-shrink-0">
        {{ userInitial }}
      </div>
      <span class="text-xs font-bold max-w-[120px] sm:max-w-[160px] truncate" style="color:rgba(255,255,255,0.8);">{{ userName }}</span>
    </a>

  </div>
</nav>
