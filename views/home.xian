{{> head }}
<style>
  body { background:#07090f; color:#e2e8f0; font-family:'Inter','Segoe UI',sans-serif; }
  .home-nav { position:sticky;top:0;z-index:50;backdrop-filter:blur(16px);background:rgba(7,9,15,0.85);border-bottom:1px solid rgba(99,102,241,0.15); }
  .glow-text { background:linear-gradient(135deg,#e0e7ff 0%,#a5b4fc 40%,#fbbf24 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }
  .hero-ring { position:absolute;border-radius:50%;border:1px solid rgba(99,102,241,0.12);pointer-events:none; }
  .feat-card { background:rgba(255,255,255,0.03);border:1px solid rgba(99,102,241,0.15);transition:transform 0.2s,border-color 0.2s,box-shadow 0.2s; }
  .feat-card:hover { transform:translateY(-4px);border-color:rgba(99,102,241,0.4);box-shadow:0 0 30px rgba(99,102,241,0.15); }
  .stat-card { background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.2); }
  .step-line { position:absolute;top:28px;left:calc(50% + 36px);right:calc(-50% + 36px);height:1px;background:linear-gradient(90deg,rgba(99,102,241,0.4),rgba(99,102,241,0.1)); }
  .btn-cta { background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 4px 24px rgba(99,102,241,0.45);transition:transform 0.15s,box-shadow 0.15s; }
  .btn-cta:hover { transform:translateY(-2px);box-shadow:0 8px 32px rgba(99,102,241,0.6); }
  .btn-ghost { background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);transition:background 0.15s; }
  .btn-ghost:hover { background:rgba(255,255,255,0.1); }
  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
  .float-badge { animation:float 4s ease-in-out infinite; }
  @keyframes count-up { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
  .count-up { animation:count-up 0.8s ease-out forwards; }
</style>
<body>

<!-- NAV -->
<header class="home-nav">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center shadow-lg" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
      </div>
      <span class="font-black text-xl tracking-tight" style="color:#e0e7ff;">Score<span style="color:#a5b4fc;">Sync</span></span>
    </div>
    <nav class="hidden md:flex items-center gap-1">
      <a href="#features" class="px-3 py-2 text-sm font-medium rounded-lg transition" style="color:#94a3b8;" onmouseover="this.style.color='#e0e7ff'" onmouseout="this.style.color='#94a3b8'">Features</a>
      <a href="#how" class="px-3 py-2 text-sm font-medium rounded-lg transition" style="color:#94a3b8;" onmouseover="this.style.color='#e0e7ff'" onmouseout="this.style.color='#94a3b8'">How it works</a>
    </nav>
    <div class="flex items-center gap-2.5">
      <a href="/login" class="btn-ghost px-4 py-2 rounded-xl text-sm font-bold hidden sm:inline-flex items-center" style="color:#c7d2fe;">Sign In</a>
      <a href="/register" class="btn-cta px-5 py-2 rounded-xl text-sm font-black text-white inline-flex items-center gap-1.5">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>Get Started
      </a>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="relative overflow-hidden min-h-screen flex items-center justify-center px-6 py-28" style="background:radial-gradient(ellipse at 50% 0%,rgba(99,102,241,0.18) 0%,transparent 60%);">
  <!-- Decorative rings -->
  <div class="hero-ring" style="width:600px;height:600px;left:50%;top:50%;transform:translate(-50%,-50%) scale(1);"></div>
  <div class="hero-ring" style="width:900px;height:900px;left:50%;top:50%;transform:translate(-50%,-50%);opacity:0.5;"></div>
  <div class="hero-ring" style="width:1200px;height:1200px;left:50%;top:50%;transform:translate(-50%,-50%);opacity:0.25;"></div>
  <!-- Glow blobs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full blur-3xl pointer-events-none" style="background:rgba(99,102,241,0.12);"></div>
  <div class="absolute bottom-0 right-1/4 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background:rgba(139,92,246,0.1);"></div>

  <div class="relative z-10 max-w-4xl mx-auto text-center">
    <!-- Location badge -->
    <div class="float-badge inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold mb-8" style="background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.3);color:#a5b4fc;">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse inline-block"></span>
      Municipality of Mansalay, Oriental Mindoro
    </div>

    <h1 class="text-5xl sm:text-7xl font-black leading-tight tracking-tighter mb-6">
      <span class="glow-text">Automated</span><br/>
      <span style="color:#e0e7ff;">Competition Scoring</span>
    </h1>
    <p class="text-lg max-w-2xl mx-auto mb-10 leading-relaxed" style="color:#64748b;">
      ScoreSync powers Mansalay's municipal competitions with real-time scoring, transparent tabulation, AI-powered anomaly detection, and instant official results.
    </p>

    <div class="flex flex-wrap gap-3 justify-center mb-16">
      <a href="/register" class="btn-cta inline-flex items-center gap-2 px-8 py-4 rounded-2xl font-black text-white text-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        Get Started Free
      </a>
      <a href="/login" class="btn-ghost inline-flex items-center gap-2 px-8 py-4 rounded-2xl font-bold text-sm" style="color:#c7d2fe;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        Sign In
      </a>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto">
      <div class="stat-card rounded-2xl p-4 text-center">
        <div class="text-2xl font-black count-up" style="color:#fbbf24;">100%</div>
        <div class="text-xs mt-1 font-medium" style="color:#64748b;">Digital Scoring</div>
      </div>
      <div class="stat-card rounded-2xl p-4 text-center">
        <div class="text-2xl font-black count-up" style="color:#34d399;">Live</div>
        <div class="text-xs mt-1 font-medium" style="color:#64748b;">Real-time Results</div>
      </div>
      <div class="stat-card rounded-2xl p-4 text-center">
        <div class="text-2xl font-black count-up" style="color:#a5b4fc;">18+</div>
        <div class="text-xs mt-1 font-medium" style="color:#64748b;">Event Types</div>
      </div>
      <div class="stat-card rounded-2xl p-4 text-center">
        <div class="text-2xl font-black count-up" style="color:#f472b6;">AI</div>
        <div class="text-xs mt-1 font-medium" style="color:#64748b;">Anomaly Detection</div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section id="features" class="py-28 px-6" style="background:rgba(10,12,22,0.95);">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest mb-4" style="background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.3);color:#a5b4fc;">Features</span>
      <h2 class="text-4xl font-black tracking-tight" style="color:#e0e7ff;">Everything You Need</h2>
      <p class="mt-3 text-base max-w-lg mx-auto" style="color:#475569;">Built for pageants, sports fests, concerts, talent shows, and any scored competition.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">

      <div class="feat-card rounded-2xl p-7">
        <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);box-shadow:0 4px 16px rgba(59,130,246,0.3);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 18 15 14"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e0e7ff;">Event Management</h3>
        <p class="text-sm leading-relaxed" style="color:#475569;">Create competitions with categories, schedules, venues, prizes, and contestant rosters. Supports concerts, pageants, sports, and 15+ more event types.</p>
      </div>

      <div class="feat-card rounded-2xl p-7">
        <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background:linear-gradient(135deg,#4c1d95,#7c3aed);box-shadow:0 4px 16px rgba(124,58,237,0.3);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e0e7ff;">Custom Scoring Criteria</h3>
        <p class="text-sm leading-relaxed" style="color:#475569;">Define weighted criteria per event — beauty, talent, intelligence, and any custom category with configurable max scores.</p>
      </div>

      <div class="feat-card rounded-2xl p-7">
        <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background:linear-gradient(135deg,#064e3b,#10b981);box-shadow:0 4px 16px rgba(16,185,129,0.3);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e0e7ff;">Live Tabulation</h3>
        <p class="text-sm leading-relaxed" style="color:#475569;">Scores aggregated and ranked in real-time as judges submit. Animated leaderboard with per-criteria breakdown and podium display.</p>
      </div>

      <div class="feat-card rounded-2xl p-7">
        <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background:linear-gradient(135deg,#7c2d12,#ea580c);box-shadow:0 4px 16px rgba(234,88,12,0.3);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="17" width="3" height="3"/><rect x="18" y="14" width="3" height="3"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e0e7ff;">QR Payment &amp; Ticketing</h3>
        <p class="text-sm leading-relaxed" style="color:#475569;">Add InstaPay / GCash QR codes to ticketed events like concerts and festivals. Track ticket sales and revenue income directly from the dashboard.</p>
      </div>

      <div class="feat-card rounded-2xl p-7">
        <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background:linear-gradient(135deg,#1e1b4b,#4f46e5);box-shadow:0 4px 16px rgba(99,102,241,0.3);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e0e7ff;">AI Score Audit</h3>
        <p class="text-sm leading-relaxed" style="color:#475569;">Gemini AI automatically detects extreme divergence, judge bias, and uniform scoring patterns — before you certify the results.</p>
      </div>

      <div class="feat-card rounded-2xl p-7">
        <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background:linear-gradient(135deg,#0f766e,#14b8a6);box-shadow:0 4px 16px rgba(20,184,166,0.3);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e0e7ff;">Stage &amp; Round Timer</h3>
        <p class="text-sm leading-relaxed" style="color:#475569;">Premium dark digital timer with neon ring, audio alerts, fullscreen auditorium mode, and per-contestant stage logs.</p>
      </div>

    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how" class="py-28 px-6" style="background:rgba(7,9,15,0.98);">
  <div class="max-w-4xl mx-auto text-center mb-16">
    <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest mb-4" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);color:#34d399;">How It Works</span>
    <h2 class="text-4xl font-black tracking-tight" style="color:#e0e7ff;">Up &amp; running in minutes</h2>
    <p class="mt-3" style="color:#475569;">Three simple steps to run a fully digital, transparent competition.</p>
  </div>
  <div class="max-w-4xl mx-auto grid md:grid-cols-3 gap-8 relative">
    <div class="text-center relative">
      <div class="hidden md:block step-line"></div>
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);box-shadow:0 0 24px rgba(59,130,246,0.4);">
        <span class="font-black text-xl text-white">1</span>
      </div>
      <h3 class="font-bold mb-2" style="color:#e0e7ff;">Create an Event</h3>
      <p class="text-sm leading-relaxed" style="color:#475569;">Admin sets up the event, adds contestants, defines scoring criteria with weights, and enables ticket payment if needed.</p>
    </div>
    <div class="text-center relative">
      <div class="hidden md:block step-line"></div>
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background:linear-gradient(135deg,#4c1d95,#7c3aed);box-shadow:0 0 24px rgba(124,58,237,0.4);">
        <span class="font-black text-xl text-white">2</span>
      </div>
      <h3 class="font-bold mb-2" style="color:#e0e7ff;">Judges Score Live</h3>
      <p class="text-sm leading-relaxed" style="color:#475569;">Judges log in from any device and enter scores per contestant per criteria. The stage timer keeps the competition on schedule.</p>
    </div>
    <div class="text-center">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background:linear-gradient(135deg,#92400e,#d97706);box-shadow:0 0 24px rgba(217,119,6,0.4);">
        <span class="font-black text-xl text-white">3</span>
      </div>
      <h3 class="font-bold mb-2" style="color:#e0e7ff;">Results Instantly</h3>
      <p class="text-sm leading-relaxed" style="color:#475569;">ScoreSync computes weighted averages, runs the AI audit, ranks contestants, and displays the official podium and tabulation sheet.</p>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-24 px-6 relative overflow-hidden" style="background:radial-gradient(ellipse at 50% 50%,rgba(99,102,241,0.18) 0%,rgba(7,9,15,0.98) 70%);">
  <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at 50% 50%,rgba(99,102,241,0.08) 0%,transparent 65%);"></div>
  <div class="relative z-10 max-w-2xl mx-auto text-center">
    <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6" style="background:linear-gradient(135deg,#f59e0b,#fbbf24);box-shadow:0 0 32px rgba(251,191,36,0.4);">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
    </div>
    <h2 class="text-4xl font-black mb-4 tracking-tight" style="color:#e0e7ff;">Ready to run your next competition?</h2>
    <p class="mb-8 text-base" style="color:#475569;">Join ScoreSync and bring efficiency and transparency to Mansalay's events.</p>
    <div class="flex gap-3 justify-center flex-wrap">
      <a href="/register" class="btn-cta inline-flex items-center gap-2 px-10 py-4 rounded-2xl font-black text-white text-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
        Start Now — It's Free
      </a>
      <a href="/login" class="btn-ghost inline-flex items-center gap-2 px-8 py-4 rounded-2xl font-bold text-sm" style="color:#c7d2fe;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        Sign In
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-8 px-6 text-center text-xs" style="color:#334155;border-top:1px solid rgba(99,102,241,0.1);">
  &copy; 2026 ScoreSync &mdash; Mansalay, Oriental Mindoro
</footer>

{{> footer }}
</body>
</html>
