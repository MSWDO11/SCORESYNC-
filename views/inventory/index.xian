{{> head }}
<style>
  .glass-card { background:rgba(15,17,35,0.95); border:1px solid rgba(99,102,241,0.18); border-radius:20px; }
  .tbl-row:hover { background:rgba(99,102,241,0.06); }
  .input-dark { background:rgba(15,17,30,0.8); border:1.5px solid rgba(99,102,241,0.2); color:#e0e7ff; border-radius:12px; width:100%; padding:10px 14px; font-size:0.875rem; outline:none; transition:border-color 0.2s,box-shadow 0.2s; }
  .input-dark::placeholder { color:#334155; }
  .input-dark:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,0.15); }
  .select-dark { background:rgba(15,17,30,0.8); border:1.5px solid rgba(99,102,241,0.2); color:#e0e7ff; border-radius:12px; width:100%; padding:10px 14px; font-size:0.875rem; outline:none; }
  .select-dark option { background:#0b0f1e; }
</style>
<body class="min-h-screen flex flex-col" style="background:#0b0f1e;color:#e2e8f0;">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6">

  <!-- Header -->
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black tracking-tight" style="color:#e0e7ff;">Payment Inventory</h1>
      <p class="text-sm mt-0.5" style="color:#475569;">Track all ticket &amp; payment records for concerts, festivals, and other ticketed events.</p>
    </div>
    <button onclick="document.getElementById('addModal').classList.remove('hidden')"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-bold text-sm transition"
      style="background:linear-gradient(135deg,#0f766e,#14b8a6);box-shadow:0 4px 16px rgba(20,184,166,0.35);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Payment Record
    </button>
  </div>

  {{#if success_msg}}
  <div class="flex items-center gap-2.5 p-3.5 rounded-xl text-sm font-semibold" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}
  </div>
  {{/if}}
  {{#if error_msg}}
  <div class="flex items-center gap-2.5 p-3.5 rounded-xl text-sm font-semibold" style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg>{{error_msg}}
  </div>
  {{/if}}

  <!-- KPI Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-2xl p-5 text-white" style="background:linear-gradient(135deg,#064e3b,#10b981);box-shadow:0 4px 20px rgba(16,185,129,0.2);">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <span class="text-[10px] font-black uppercase tracking-wider" style="color:rgba(255,255,255,0.6);">Total Revenue</span>
      </div>
      <div class="text-2xl font-black">₱{{totalRevenue}}</div>
      <div class="text-xs mt-1" style="color:rgba(255,255,255,0.6);">{{recordCount}} payment record(s)</div>
    </div>
    <div class="rounded-2xl p-5 text-white" style="background:linear-gradient(135deg,#0f766e,#14b8a6);box-shadow:0 4px 20px rgba(20,184,166,0.2);">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/></svg>
        </div>
        <span class="text-[10px] font-black uppercase tracking-wider" style="color:rgba(255,255,255,0.6);">Tickets Sold</span>
      </div>
      <div class="text-2xl font-black">{{totalTickets}}</div>
      <div class="text-xs mt-1" style="color:rgba(255,255,255,0.6);">Across all events</div>
    </div>
    <div class="rounded-2xl p-5 text-white" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);box-shadow:0 4px 20px rgba(59,130,246,0.2);">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <span class="text-[10px] font-black uppercase tracking-wider" style="color:rgba(255,255,255,0.6);">Confirmed</span>
      </div>
      <div class="text-2xl font-black">{{confirmedCount}}</div>
      <div class="text-xs mt-1" style="color:rgba(255,255,255,0.6);">Confirmed payments</div>
    </div>
    <div class="rounded-2xl p-5 text-white" style="background:linear-gradient(135deg,#78350f,#f59e0b);box-shadow:0 4px 20px rgba(245,158,11,0.2);">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <span class="text-[10px] font-black uppercase tracking-wider" style="color:rgba(255,255,255,0.6);">Pending</span>
      </div>
      <div class="text-2xl font-black">{{pendingCount}}</div>
      <div class="text-xs mt-1" style="color:rgba(255,255,255,0.6);">Awaiting confirmation</div>
    </div>
  </div>

  <!-- Revenue by Event -->
  {{#if eventSummary.length}}
  <div class="glass-card overflow-hidden">
    <div class="px-6 py-4 flex items-center gap-2.5" style="border-bottom:1px solid rgba(99,102,241,0.15);">
      <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:rgba(20,184,166,0.15);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </div>
      <h2 class="text-sm font-extrabold" style="color:#e0e7ff;">Revenue by Event</h2>
    </div>
    <div>
      {{#each eventSummary}}
      <div class="tbl-row flex items-center justify-between px-6 py-3.5" style="border-bottom:1px solid rgba(99,102,241,0.07);">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(20,184,166,0.12);">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/></svg>
          </div>
          <div>
            <div class="text-sm font-bold" style="color:#e0e7ff;">{{eventName}}</div>
            <div class="text-xs" style="color:#475569;">{{count}} record(s) &bull; {{tickets}} ticket(s)</div>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="font-black text-base" style="color:#34d399;">₱<span data-fmt="{{revenue}}">{{revenue}}</span></span>
          <a href="/inventory?event={{eventId}}" class="px-3 py-1 rounded-lg text-xs font-bold" style="background:rgba(20,184,166,0.12);color:#14b8a6;">Filter</a>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <!-- Filter Bar -->
  <div class="flex flex-wrap items-center gap-3">
    <form method="GET" action="/inventory" class="flex items-center gap-2">
      <label class="text-xs font-bold uppercase tracking-wider" style="color:#475569;">Filter by Event:</label>
      <select name="event" onchange="this.form.submit()" class="select-dark px-3 py-1.5 rounded-xl text-xs font-semibold" style="width:auto;">
        <option value="">All Events</option>
        {{#each allEvents}}
        <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
      {{#if filterEventId}}
      <a href="/inventory" class="px-3 py-1.5 rounded-xl text-xs font-bold transition" style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.25);color:#fca5a5;">✕ Clear</a>
      {{/if}}
    </form>
    <span class="text-xs ml-auto" style="color:#334155;">{{recordCount}} record(s) shown</span>
  </div>

  <!-- Records Table -->
  <div class="glass-card overflow-hidden">
    <div class="px-6 py-4 flex items-center gap-2.5" style="border-bottom:1px solid rgba(99,102,241,0.15);">
      <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:rgba(20,184,166,0.15);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      </div>
      <h2 class="text-sm font-extrabold" style="color:#e0e7ff;">Payment Records</h2>
    </div>

    {{#if records.length}}
    <div class="overflow-x-auto">
      <table class="w-full text-left" style="min-width:800px;">
        <thead>
          <tr style="border-bottom:1px solid rgba(99,102,241,0.12);">
            <th class="py-3 px-5 text-[11px] font-black uppercase tracking-wider" style="color:#334155;">Event</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider" style="color:#334155;">Payer</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider text-center" style="color:#334155;">Qty</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider text-right" style="color:#334155;">Unit Price</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider text-right" style="color:#334155;">Total</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider" style="color:#334155;">Method</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider" style="color:#334155;">Reference</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider text-center" style="color:#334155;">Status</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider" style="color:#334155;">Recorded By</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider" style="color:#334155;">Date</th>
            <th class="py-3 px-4 text-[11px] font-black uppercase tracking-wider text-center" style="color:#334155;">Del</th>
          </tr>
        </thead>
        <tbody>
          {{#each records}}
          <tr class="tbl-row" style="border-bottom:1px solid rgba(99,102,241,0.07);">
            <td class="py-3 px-5"><span class="font-bold text-xs" style="color:#e0e7ff;">{{eventName}}</span></td>
            <td class="py-3 px-4 font-semibold text-sm" style="color:#c7d2fe;">{{payerName}}</td>
            <td class="py-3 px-4 text-center font-bold" style="color:#c7d2fe;">{{quantity}}</td>
            <td class="py-3 px-4 text-right text-xs font-semibold" style="color:#64748b;">₱{{unitPrice}}</td>
            <td class="py-3 px-4 text-right font-black" style="color:#34d399;">₱<span data-fmt="{{total}}">{{total}}</span></td>
            <td class="py-3 px-4">
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold"
                style="{{#if (eq method 'GCash')}}background:rgba(59,130,246,0.15);color:#93c5fd;border:1px solid rgba(59,130,246,0.3);
                {{else}}{{#if (eq method 'InstaPay')}}background:rgba(20,184,166,0.15);color:#5eead4;border:1px solid rgba(20,184,166,0.3);
                {{else}}{{#if (eq method 'Maya')}}background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);
                {{else}}background:rgba(99,102,241,0.12);color:#a5b4fc;border:1px solid rgba(99,102,241,0.25);{{/if}}{{/if}}{{/if}}">
                {{method}}
              </span>
            </td>
            <td class="py-3 px-4 font-mono text-xs" style="color:#475569;">{{reference}}</td>
            <td class="py-3 px-4 text-center">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-black"
                style="{{#if (eq status 'Confirmed')}}background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);
                {{else}}{{#if (eq status 'Pending')}}background:rgba(245,158,11,0.15);color:#fcd34d;border:1px solid rgba(245,158,11,0.3);
                {{else}}background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);{{/if}}{{/if}}">
                {{status}}
              </span>
            </td>
            <td class="py-3 px-4 text-xs" style="color:#475569;">{{recordedBy}}</td>
            <td class="py-3 px-4 text-xs font-mono whitespace-nowrap" style="color:#334155;">{{createdAt}}</td>
            <td class="py-3 px-4 text-center">
              <form method="POST" action="/inventory/{{id}}/delete" onsubmit="return confirm('Delete this record?')">
                <button type="submit" class="p-1.5 rounded-lg transition" style="color:#334155;" onmouseover="this.style.background='rgba(239,68,68,0.15)';this.style.color='#fca5a5'" onmouseout="this.style.background='transparent';this.style.color='#334155'">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                </button>
              </form>
            </td>
          </tr>
          {{/each}}
        </tbody>
        <tfoot style="border-top:2px solid rgba(99,102,241,0.2);">
          <tr>
            <td colspan="4" class="py-3.5 px-5 text-xs font-black uppercase tracking-wider text-right" style="color:#475569;">Total</td>
            <td class="py-3.5 px-4 text-right font-black" style="color:#34d399;">₱{{totalRevenue}}</td>
            <td colspan="6"></td>
          </tr>
        </tfoot>
      </table>
    </div>
    {{else}}
    <div class="py-20 flex flex-col items-center justify-center text-center">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4" style="background:rgba(20,184,166,0.1);border:1px solid rgba(20,184,166,0.2);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="1.5"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/></svg>
      </div>
      <p class="font-bold" style="color:#475569;">No payment records yet.</p>
      <p class="text-sm mt-1" style="color:#334155;">Click <strong style="color:#14b8a6;">Add Payment Record</strong> to log the first entry.</p>
    </div>
    {{/if}}
  </div>

</main>
</div>

<!-- ADD MODAL -->
<div id="addModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background:rgba(0,0,0,0.6);backdrop-filter:blur(6px);">
  <div class="rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden" style="background:#0d1035;border:1px solid rgba(20,184,166,0.3);">
    <div class="px-6 py-5 flex items-center justify-between" style="background:linear-gradient(135deg,#0f766e,#14b8a6);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <h2 class="font-extrabold text-white text-base">Add Payment Record</h2>
      </div>
      <button onclick="document.getElementById('addModal').classList.add('hidden')" class="text-white/70 hover:text-white">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form method="POST" action="/inventory" class="px-6 py-5 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color:#475569;">Event <span class="text-red-400">*</span></label>
          <select name="eventId" required class="select-dark">
            <option value="">— Select ticketed event —</option>
            {{#each allEvents}}
            <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color:#475569;">Payer Name</label>
          <input type="text" name="payerName" placeholder="e.g. Juan dela Cruz or Walk-in" class="input-dark"/>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color:#475569;">Quantity <span class="text-red-400">*</span></label>
          <input type="number" name="quantity" min="1" value="1" required class="input-dark" id="qtyInput" oninput="calcTotal()"/>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color:#475569;">Unit Price (₱) <span class="text-red-400">*</span></label>
          <input type="number" name="unitPrice" min="0" step="0.01" placeholder="0.00" required class="input-dark" id="priceInput" oninput="calcTotal()"/>
        </div>
        <div class="col-span-2 flex items-center justify-between px-4 py-3 rounded-xl" style="background:rgba(20,184,166,0.08);border:1px solid rgba(20,184,166,0.2);">
          <span class="text-xs font-bold" style="color:#5eead4;">Total Amount</span>
          <span class="font-black text-lg" style="color:#14b8a6;" id="totalPreview">₱0.00</span>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color:#475569;">Payment Method</label>
          <select name="method" class="select-dark">
            <option value="Cash">Cash</option>
            <option value="GCash">GCash</option>
            <option value="InstaPay">InstaPay</option>
            <option value="Maya">Maya</option>
            <option value="Bank Transfer">Bank Transfer</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color:#475569;">Status</label>
          <select name="status" class="select-dark">
            <option value="Confirmed">Confirmed</option>
            <option value="Pending">Pending</option>
            <option value="Cancelled">Cancelled</option>
          </select>
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color:#475569;">Reference / Transaction No.</label>
          <input type="text" name="reference" placeholder="e.g. GCash ref #1234ABCD" class="input-dark"/>
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color:#475569;">Notes</label>
          <textarea name="notes" rows="2" placeholder="Optional notes..." class="input-dark" style="resize:none;"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-3 pt-2">
        <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')"
          class="px-5 py-2.5 rounded-xl font-bold text-sm transition"
          style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:#94a3b8;">Cancel</button>
        <button type="submit" class="px-6 py-2.5 rounded-xl text-white font-extrabold text-sm"
          style="background:linear-gradient(135deg,#0f766e,#14b8a6);box-shadow:0 4px 14px rgba(20,184,166,0.35);">Save Record</button>
      </div>
    </form>
  </div>
</div>

<script>
  function calcTotal() {
    const qty   = parseFloat(document.getElementById('qtyInput').value)   || 0;
    const price = parseFloat(document.getElementById('priceInput').value) || 0;
    document.getElementById('totalPreview').textContent = '₱' + (qty*price).toLocaleString('en-PH',{minimumFractionDigits:2,maximumFractionDigits:2});
  }
  document.querySelectorAll('[data-fmt]').forEach(el => {
    const v = parseFloat(el.getAttribute('data-fmt')) || 0;
    el.textContent = v.toLocaleString('en-PH',{minimumFractionDigits:2,maximumFractionDigits:2});
  });
  {{#if error_msg}}document.getElementById('addModal').classList.remove('hidden');{{/if}}
</script>

{{> footer }}
</body>
</html>
